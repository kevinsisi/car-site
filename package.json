{
  "name": "personal-premium-car-site",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:workers": "MITA_RUNTIME=workers npm run build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "astro check",
    "test:d1-schema": "node scripts/test-d1-migrations.mjs",
    "test:workers-routes": "node --import tsx --test tests/routes/*.test.mjs",
    "test:workers-d1": "npm run test:d1-schema && node --import tsx --test tests/db/d1-adapter.test.mjs && node --import tsx --test tests/db/vehicles-d1.test.mjs && node --import tsx --test tests/db/settings-d1.test.mjs && node --import tsx --test tests/db/vehicles-d1-writes.test.mjs && node --test tests/db/demo-fixtures-d1.test.mjs",
    "test:workers-media": "node --import tsx --test tests/media/*.test.mjs",
    "test:workers-auth": "node --import tsx --test tests/auth/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/node": "^9.0.0",
    "@astrojs/svelte": "^7.0.0",
    "@astrojs/ts-plugin": "^1.10.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "astro": "^5.0.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.38.4",
    "nodemailer": "^8.0.10",
    "sharp": "^0.34.5",
    "svelte": "^5.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.30.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.3.2",
    "wrangler": "^4.144.0"
  }
}
