---
interface Props {
  iconUrl: string | null | undefined;
  alt?: string;
  name?: string;
  size?: number;
  class?: string;
}
const { iconUrl, alt = '', name = alt, size = 24, class: className = '' } = Astro.props;
// Toyota's official asset is a wide lockup; keep the full mark legible.
const width = iconUrl === '/brand-icons/toyota.png' ? size * 3 : size;
const initials = name.split(/[\s-]+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || '車';
---
<span class={`brand-icon ${className}`.trim()} data-brand-icon style={`width:${width}px;height:${size}px`} aria-hidden={alt ? undefined : 'true'} role={alt ? 'img' : undefined} aria-label={alt || undefined}>
  {iconUrl && <img src={iconUrl} alt="" width={width} height={size} loading="lazy" decoding="async" />}
  <span class="brand-icon__fallback" hidden={Boolean(iconUrl)} title={name}>{initials}</span>
</span>

<style>
.brand-icon { max-width: 100%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; vertical-align: middle; }
.brand-icon img { width: 100%; height: 100%; object-fit: contain; }
.brand-icon__fallback { display: inline-grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: var(--surface-soft); color: var(--accent-strong); font-size: 0.6em; font-weight: 750; line-height: 1; }
.brand-icon [hidden] { display: none; }
</style>
