---
type Platform = 'line' | 'instagram' | 'facebook' | 'threads' | 'tiktok' | 'phone' | 'share' | 'store' | 'clock';

interface CustomIcon {
  url: string;
  zoom: number;
  offsetX: number;
  offsetY: number;
  bgColor: string;
}

interface Props {
  platform: Platform;
  label?: string;
  customIcon?: CustomIcon;
  class?: string;
}

const { platform, label = '', customIcon } = Astro.props;
const className = Astro.props.class || '';
const customStyle = customIcon
  ? `width: ${(customIcon.zoom || 1) * 100}%; height: ${(customIcon.zoom || 1) * 100}%; object-position: ${customIcon.offsetX ?? 50}% ${customIcon.offsetY ?? 50}%;`
  : '';
const chipStyle = customIcon?.bgColor ? `background: ${customIcon.bgColor}; border-color: transparent;` : '';
---

<span class={`premium-icon premium-icon--${platform}${customIcon ? ' premium-icon--custom' : ''}${className ? ` ${className}` : ''}`} aria-hidden="true" style={chipStyle}>
  {customIcon ? (
    <img class="premium-icon__custom-img" src={customIcon.url} alt={label} style={customStyle} loading="lazy" decoding="async" />
  ) : (
    <>
      {platform === 'line' && (
        <svg class="premium-icon__line-logo" viewBox="0 0 48 48" focusable="false">
          <path class="premium-icon__line-bubble" d="M24 6C13.5 6 5 12.9 5 21.4c0 7.6 6.7 14 15.8 15.2.6.1 1.4.4 1.6.9.2.5.1 1.2.1 1.7l-.3 2c-.1.6-.5 2.3 1.7 1.3 2.2-1 11.7-6.9 16-11.8 3-3.3 4.1-6.4 4.1-9.3C43 12.9 34.5 6 24 6Z" />
          <text class="premium-icon__line-text" x="24" y="20.6" text-anchor="middle" dominant-baseline="central" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="10.5" letter-spacing="-0.35">LINE</text>
        </svg>
      )}
      {platform === 'instagram' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <rect x="4.4" y="4.4" width="15.2" height="15.2" rx="4.4" />
          <circle cx="12" cy="12" r="3.7" />
          <circle cx="16.75" cy="7.25" r="0.85" />
        </svg>
      )}
      {platform === 'facebook' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M14.05 8.25h2.15V4.8h-2.6c-3.05 0-4.55 1.82-4.55 4.35v2.1H6.7v3.55h2.35v6.05h3.75V14.8h2.9l.45-3.55H12.8V9.42c0-.82.33-1.17 1.25-1.17Z" />
        </svg>
      )}
      {platform === 'threads' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M18.9 8.45c-.85-3.25-3.1-4.75-6.67-4.78-5.05.04-7.56 3.13-7.6 8.33.04 5.2 2.55 8.3 7.6 8.33 2.95-.02 5.02-.84 6.38-2.52 1.58-1.95 1.06-4.42-.62-5.6-1.17-.82-2.73-1.2-4.72-1.1-2.3.12-3.62 1.12-3.55 2.72.07 1.46 1.45 2.35 3.34 2.2 2.16-.18 3.25-1.58 3.25-4.15 0-2.72-1.35-4.18-3.9-4.2-1.75 0-2.95.78-3.45 2.22" />
        </svg>
      )}
      {platform === 'tiktok' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M14.65 4.5c.38 3.1 2.1 5.05 5.05 5.25v3.35c-1.72.05-3.35-.48-4.92-1.47v6.28c0 3.55-2.38 5.92-5.65 5.92-3.05 0-5.35-2.22-5.35-5.15 0-3.3 2.7-5.55 6.1-5.02v3.48c-1.45-.35-2.65.45-2.65 1.62 0 1.05.82 1.82 1.9 1.82 1.25 0 2.05-.82 2.05-2.32V4.5h3.47Z" />
        </svg>
      )}
      {platform === 'phone' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M6.55 4.85c.58-.36 1.3-.18 1.64.42l1.12 1.95c.3.52.22 1.17-.2 1.6l-.88.92a12.35 12.35 0 0 0 6.02 6.02l.92-.88c.43-.42 1.08-.5 1.6-.2l1.95 1.12c.6.34.78 1.06.42 1.64l-.78 1.24c-.4.64-1.18.94-1.92.76A17.35 17.35 0 0 1 4.56 7.56c-.18-.74.12-1.52.76-1.92l1.23-.79Z" />
        </svg>
      )}
      {platform === 'share' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <circle cx="6.5" cy="12" r="2.7" />
          <circle cx="17.5" cy="6.6" r="2.7" />
          <circle cx="17.5" cy="17.4" r="2.7" />
          <path d="M8.9 10.8 15.1 7.7M8.9 13.2l6.2 3.1" />
        </svg>
      )}
      {platform === 'store' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M4.2 9.4 5.6 5.5h12.8l1.4 3.9v1.15c0 1.28-1.05 2.32-2.35 2.32-.95 0-1.77-.55-2.14-1.35a2.37 2.37 0 0 1-4.28 0 2.37 2.37 0 0 1-4.28 0 2.35 2.35 0 0 1-4.45-1.02V9.4Z" />
          <path d="M5.6 12.5v6.7h12.8v-6.7M10 19.2v-4.35h4v4.35" />
        </svg>
      )}
      {platform === 'clock' && (
        <svg viewBox="0 0 24 24" focusable="false">
          <circle cx="12" cy="12" r="8.3" />
          <path d="M12 7.25V12l3.4 2.05" />
        </svg>
      )}
    </>
  )}
</span>
