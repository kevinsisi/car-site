---
import PremiumIcon from './PremiumIcon.astro';

type Platform = "line" | "instagram" | "facebook" | "threads" | "tiktok";

interface CustomIcon {
  url: string;
  zoom: number;
  offsetX: number;
  offsetY: number;
  bgColor: string;
}

interface Props {
  platform: Platform;
  href: string;
  label: string;
  customIcon?: CustomIcon;
}

const { platform, href, label, customIcon } = Astro.props;
---

<a
  class={`social-icon social-icon--${platform}${customIcon ? ' social-icon--custom' : ''}`}
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
>
  <PremiumIcon platform={platform} label={label} customIcon={customIcon} />
</a>
