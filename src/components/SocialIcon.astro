---
type Platform = "line" | "instagram" | "facebook" | "threads" | "tiktok";

interface Props {
  platform: Platform;
  href: string;
  label: string;
}

const { platform, href, label } = Astro.props;
---

<a
  class={`social-icon social-icon--${platform}`}
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
>
  {
    platform === "line" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <circle class="line-badge" cx="24" cy="24" r="23" />
        <path class="line-bubble" d="M24 11C16 11 9.5 16.4 9.5 23c0 5.95 5.15 10.95 12.1 11.9.46.08 1.1.25 1.26.58.15.3.1.77.05 1.07l-.2 1.3c-.06.38-.3 1.5 1.32.82 1.62-.67 8.78-5.18 11.97-8.86 2.2-2.42 3.5-4.86 3.5-7.81 0-6.6-6.5-12-14.5-12Z" />
        <text class="line-letters" x="24" y="22.4" text-anchor="middle" dominant-baseline="central" font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-weight="900" font-size="10" letter-spacing="-0.5">LINE</text>
      </svg>
    )
  }
  {
    platform === "instagram" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M15 5h18c5.5 0 10 4.5 10 10v18c0 5.5-4.5 10-10 10H15C9.5 43 5 38.5 5 33V15C5 9.5 9.5 5 15 5Zm.3 5A5.3 5.3 0 0 0 10 15.3v17.4a5.3 5.3 0 0 0 5.3 5.3h17.4a5.3 5.3 0 0 0 5.3-5.3V15.3a5.3 5.3 0 0 0-5.3-5.3H15.3ZM24 15.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6Zm0 5a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm9.4-5.9a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4Z" />
      </svg>
    )
  }
  {
    platform === "facebook" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M43 24.1C43 13.6 34.5 5 24 5S5 13.6 5 24.1C5 33.6 11.9 41.5 20.9 43V29.6h-4.8v-5.5h4.8v-4.2c0-4.8 2.8-7.4 7.2-7.4 2.1 0 4.3.4 4.3.4v4.7H30c-2.4 0-3.1 1.5-3.1 3v3.5h5.3l-.8 5.5h-4.5V43C36.1 41.5 43 33.6 43 24.1Z" />
      </svg>
    )
  }
  {
    platform === "threads" && (
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.97-3.91-5.997-8.31-6.03-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.05 7.178 1.43 1.781 3.631 2.695 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.74-1.757-.503-.585-1.279-.883-2.31-.89h-.029c-.823 0-1.508.166-2.038.49-.626.385-1.046.973-1.246 1.748l-2.038-.544c.275-1.27.952-2.358 1.957-3.146 1.025-.802 2.404-1.214 4.029-1.207 2.111.011 3.775.652 4.945 1.906 1.073 1.151 1.677 2.751 1.798 4.76.069.029.139.058.207.088 1.713.806 2.962 2.044 3.583 3.546.806 1.937.713 4.736-2.108 7.486-2.119 2.07-4.692 2.95-7.798 2.952Zm1.064-7.439c-.302 0-.626.043-.978.13-1.214.341-1.825.918-1.825 1.717 0 .53.293 1.005.808 1.317.469.284 1.106.448 1.842.476 1.143.044 2.064-.327 2.708-1.103.567-.683.83-1.621.83-2.964l-.121-.036c-.972-.27-2.029-.398-3.022-.395-.078 0-.156 0-.243.001Z" />
      </svg>
    )
  }
  {
    platform === "tiktok" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <g transform="translate(24 24) scale(1.18) translate(-24 -24)">
          <path d="M31.1 5c.8 6 4.2 9.8 10 10.2v6.9c-3.4.1-6.6-1-9.8-3v13.2c0 6.8-4.6 11.7-11.3 11.7-6.3 0-11.1-4.6-11.1-10.8 0-6.7 5.5-11.5 12.7-10.3v7.2c-3.1-.9-5.7.8-5.7 3.2 0 2.2 1.8 3.8 4 3.8 2.6 0 4.3-1.7 4.3-4.8V5h6.9Z" />
        </g>
      </svg>
    )
  }
</a>
