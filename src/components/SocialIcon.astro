---
type Platform = "line" | "instagram" | "facebook" | "threads" | "tiktok";

interface Props {
  platform: Platform;
  href: string;
  label: string;
}

const { platform, href, label } = Astro.props;
---

<a
  class={`social-icon social-icon--${platform}`}
  href={href}
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
>
  {
    platform === "line" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <circle class="line-badge" cx="24" cy="24" r="23" />
        <g transform="translate(24 24) scale(0.6) translate(-24 -24)">
          <path class="line-bubble" d="M24 6C13.5 6 5 12.9 5 21.4c0 7.6 6.7 14 15.8 15.2.6.1 1.4.4 1.6.9.2.5.1 1.2.1 1.7l-.3 2c-.1.6-.5 2.3 1.7 1.3 2.2-1 11.7-6.9 16-11.8 3-3.3 4.1-6.4 4.1-9.3C43 12.9 34.5 6 24 6Z" />
          <path
            class="line-text"
            transform="translate(-4 -3)"
            d="M13.4 26.2h6v-2.4h-3.3v-8.1h-2.7v10.5Zm7.2 0h2.7V15.7h-2.7v10.5Zm4.7 0H28v-6l4.8 6h2.4V15.7h-2.7v5.9l-4.7-5.9h-2.5v10.5Zm11.4 0h6.2v-2.3h-3.5v-1.8h3.1v-2.2h-3.1V18h3.5v-2.3h-6.2v10.5Z"
          />
        </g>
      </svg>
    )
  }
  {
    platform === "instagram" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M15 5h18c5.5 0 10 4.5 10 10v18c0 5.5-4.5 10-10 10H15C9.5 43 5 38.5 5 33V15C5 9.5 9.5 5 15 5Zm.3 5A5.3 5.3 0 0 0 10 15.3v17.4a5.3 5.3 0 0 0 5.3 5.3h17.4a5.3 5.3 0 0 0 5.3-5.3V15.3a5.3 5.3 0 0 0-5.3-5.3H15.3ZM24 15.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6Zm0 5a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm9.4-5.9a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4Z" />
      </svg>
    )
  }
  {
    platform === "facebook" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M43 24.1C43 13.6 34.5 5 24 5S5 13.6 5 24.1C5 33.6 11.9 41.5 20.9 43V29.6h-4.8v-5.5h4.8v-4.2c0-4.8 2.8-7.4 7.2-7.4 2.1 0 4.3.4 4.3.4v4.7H30c-2.4 0-3.1 1.5-3.1 3v3.5h5.3l-.8 5.5h-4.5V43C36.1 41.5 43 33.6 43 24.1Z" />
      </svg>
    )
  }
  {
    platform === "threads" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <g transform="translate(24 24) scale(1.22) translate(-24 -24)">
          <path d="M31.6 22.6c-.2-5.5-3.3-8.7-8.5-8.7-5.5 0-9.2 3.9-9.2 10.2 0 6.8 3.8 10.5 10.2 10.5 5.3 0 8.6-2.7 8.6-6.8 0-3.6-2.7-5.8-7.2-5.9-4.1-.1-6.7 1.8-6.7 4.7 0 2.6 2.1 4.4 5.2 4.4 3.5 0 5.9-2.1 6.4-5.5 1.8.8 2.7 2.2 2.7 4.1 0 4.4-3.7 7.2-9.3 7.2-7.3 0-12.1-4.9-12.1-12.7 0-7.4 4.8-12.2 11.4-12.2 6.4 0 10.6 4 11.1 10.4l3.8 1.1C37.4 13 31.7 7.7 23.1 7.7 14.3 7.7 8 14.2 8 24.1 8 34.2 14.3 40.4 24 40.4c8 0 13.2-4.7 13.2-11.7 0-3.1-1-5.6-3-7.4l-2.6 1.3Zm-7.3 5.2c-1.1 0-1.8-.5-1.8-1.4 0-1 1-1.6 2.6-1.6.6 0 1.2.1 1.8.2-.3 1.7-1.2 2.8-2.6 2.8Z" />
        </g>
      </svg>
    )
  }
  {
    platform === "tiktok" && (
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <g transform="translate(24 24) scale(1.18) translate(-24 -24)">
          <path d="M31.1 5c.8 6 4.2 9.8 10 10.2v6.9c-3.4.1-6.6-1-9.8-3v13.2c0 6.8-4.6 11.7-11.3 11.7-6.3 0-11.1-4.6-11.1-10.8 0-6.7 5.5-11.5 12.7-10.3v7.2c-3.1-.9-5.7.8-5.7 3.2 0 2.2 1.8 3.8 4 3.8 2.6 0 4.3-1.7 4.3-4.8V5h6.9Z" />
        </g>
      </svg>
    )
  }
</a>
