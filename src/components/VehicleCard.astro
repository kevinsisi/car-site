---
import type { VehicleView } from '@/lib/vehicles';

interface Props {
  vehicle: VehicleView;
}

const { vehicle } = Astro.props;
const image = vehicle.coverImage;
---

<article class="vehicle-card reveal-card">
  <a href={`/cars/${vehicle.slug}`} aria-label={`查看 ${vehicle.title}`}>
    <div class="vehicle-card__media">
      {image ? <img src={image.url} alt={image.alt || vehicle.title} loading="lazy" decoding="async" /> : <div class="image-placeholder">Awaiting Image</div>}
      {vehicle.monthlyRecommended && <span class="vehicle-badge">本月推薦</span>}
    </div>
    <div class="vehicle-card__body">
      <p class="eyebrow">{vehicle.brandDisplayName}</p>
      <h2>{vehicle.title}</h2>
      <p class="spec-line">{[vehicle.year, vehicle.mileage, vehicle.condition].filter(Boolean).join(' / ')}</p>
      <div class="card-footer">
        <span>價格請洽</span>
        <span>查看詳情</span>
      </div>
    </div>
  </a>
</article>
