---
import type { VehicleView } from '@/lib/vehicles';
import ShareButton from './ShareButton.astro';
import BrandIcon from './BrandIcon.astro';
import { vehicleStatusLabels } from '@/lib/vehicle-status';

interface Props {
  vehicle: VehicleView;
  shareText?: string;
  variant?: 'featured' | 'listing';
  compareEnabled?: boolean;
}

const { vehicle, shareText, variant = 'featured', compareEnabled = true } = Astro.props;
const image = vehicle.coverImage;
const imageSrc = image ? (variant === 'featured' ? image.url : image.thumbUrl) : '';
const statusBadge = vehicle.status !== 'published' ? vehicleStatusLabels[vehicle.status] : '';
const specs = [
  { label: '年份', value: vehicle.year, icon: 'calendar' },
  { label: '里程', value: vehicle.mileage, icon: 'gauge' },
  { label: '車況', value: vehicle.condition, icon: 'car' },
].filter((spec) => spec.value);
---

<article class:list={['vehicle-card', 'reveal-card', `vehicle-card--${variant}`]}>
  <a href={`/cars/${vehicle.slug}`} aria-label={`查看 ${vehicle.title}`} rel="prefetch">
    <div class="vehicle-card__media">
      {image ? <img src={imageSrc} alt={image.alt || `${vehicle.title} 封面照`} loading="lazy" decoding="async" width="800" height="533" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px" /> : <div class="image-placeholder">相片整理中</div>}
      {statusBadge ? (
        <span class={`vehicle-badge${vehicle.status === 'sold' ? ' vehicle-badge--sold' : ''}`}>{statusBadge}</span>
      ) : vehicle.monthlyRecommended ? (
        <span class="vehicle-badge">本月推薦</span>
      ) : null}
      {vehicle.brandIconUrl && (
        <span class="vehicle-card__brand-badge" aria-hidden="true">
          <BrandIcon iconUrl={vehicle.brandIconUrl} alt={vehicle.brandDisplayName} size={32} />
        </span>
      )}
    </div>
      <div class="vehicle-card__body">
        <p class="eyebrow">{vehicle.brandDisplayName}</p>
        <h2>{vehicle.cardTitle}</h2>
        <ul class="spec-list" aria-label="車輛資訊">
          {specs.map((spec) => (
            <li class="spec-item">
              <span class="spec-icon" aria-hidden="true">
                {spec.icon === 'calendar' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 3v3M17 3v3M4.5 9.5h15M6.5 5.5h11A2.5 2.5 0 0 1 20 8v9.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5V8a2.5 2.5 0 0 1 2.5-2.5Z" />
                  </svg>
                )}
                {spec.icon === 'gauge' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4.8 16.6a8 8 0 1 1 14.4 0M12 12.8l4.2-4.2M7.6 15.8h8.8" />
                  </svg>
                )}
                {spec.icon === 'car' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 14l1.6-4.2A2.8 2.8 0 0 1 9.2 8h5.6a2.8 2.8 0 0 1 2.6 1.8L19 14M4.5 14h15v4.2H17M7 18.2H5.5M7.2 14.2h.1M16.7 14.2h.1M7 18.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6ZM17 18.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z" />
                  </svg>
                )}
              </span>
              <span class="spec-copy"><span>{spec.label}</span><strong>{spec.value}</strong></span>
            </li>
          ))}
        </ul>
        <div class="card-footer">
        <span>價格請洽</span>
        <span>查看詳情</span>
      </div>
    </div>
  </a>
  <ShareButton class="vehicle-share" title={vehicle.title} url={`/cars/${vehicle.slug}`} text={shareText} />
  {compareEnabled && (
    <button
      type="button"
      class="compare-btn"
      data-compare-slug={vehicle.slug}
      data-compare-title={vehicle.cardTitle}
      data-compare-thumb={vehicle.coverImage?.thumbUrl || vehicle.coverImage?.url || ''}
      aria-label={`加入比較：${vehicle.title}`}
    >
      ＋ 比較
    </button>
  )}
</article>

{compareEnabled && (
  <script>
    // Update button state from localStorage on load and on changes
    function refreshCompareButtons() {
      const stored = JSON.parse(localStorage.getItem('compare_slugs') || '[]') as string[];
      document.querySelectorAll<HTMLButtonElement>('[data-compare-slug]').forEach((btn) => {
        const slug = btn.dataset.compareSlug!;
        const active = stored.includes(slug);
        btn.classList.toggle('compare-btn--active', active);
        btn.textContent = active ? '✓ 已加入' : '＋ 比較';
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-compare-slug]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.compareSlug!;
        const stored: string[] = JSON.parse(localStorage.getItem('compare_slugs') || '[]');
        const idx = stored.indexOf(slug);
        if (idx >= 0) stored.splice(idx, 1);
        else stored.push(slug);
        localStorage.setItem('compare_slugs', JSON.stringify(stored));
        window.dispatchEvent(new CustomEvent('compare-changed', { detail: stored }));
        refreshCompareButtons();
      });
    });

    refreshCompareButtons();
    window.addEventListener('compare-changed', refreshCompareButtons);
  </script>
)}

<style>
  .compare-btn {
    display: inline-block;
    font-size: 0.75rem;
    padding: 3px 10px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 4px;
    background: none;
    cursor: pointer;
    color: var(--muted, #777);
    transition: all 0.15s;
  }
  .compare-btn--active {
    border-color: var(--accent, #0066cc);
    color: var(--accent, #0066cc);
    background: var(--accent-subtle, #f0f6ff);
  }
  .compare-btn:hover { opacity: 0.8; }
</style>
