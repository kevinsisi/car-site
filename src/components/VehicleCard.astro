---
import type { VehicleView } from '@/lib/vehicles';
import ShareButton from './ShareButton.astro';
import BrandIcon from './BrandIcon.astro';
import { vehicleStatusLabels } from '@/lib/vehicle-status';
import { formatMileage } from '@/lib/format-mileage';

interface Props {
  vehicle: VehicleView;
  shareText?: string;
  variant?: 'featured' | 'listing';
  compareEnabled?: boolean;
  imagePriority?: boolean;
}

const { vehicle, shareText, variant = 'featured', compareEnabled = true, imagePriority = false } = Astro.props;
const image = vehicle.coverImage;
const imageSrc = image ? (variant === 'featured' ? image.url : image.thumbUrl || image.url) : '';
const imageSrcSet = image && variant === 'listing' && image.url !== image.thumbUrl ? `${image.thumbUrl} 600w, ${image.url} 1800w` : undefined;
const statusBadge = vehicle.status !== 'published' ? vehicleStatusLabels[vehicle.status] : '';
const specs = [
  { label: '年份', value: vehicle.year, icon: 'calendar' },
  { label: '里程', value: formatMileage(vehicle.mileage), icon: 'gauge' },
  { label: '車況', value: vehicle.condition, icon: 'car' },
];

---

<article class:list={['vehicle-card', 'reveal-card', `vehicle-card--${variant}`]}>
  <a href={`/cars/${vehicle.slug}`} aria-label={`查看 ${vehicle.title}`} rel="prefetch">
    <div class="vehicle-card__media">
      {image ? <img src={imageSrc} srcset={imageSrcSet} alt={image.alt || `${vehicle.title} 封面照`} loading={imagePriority ? 'eager' : 'lazy'} fetchpriority={imagePriority ? 'high' : undefined} decoding="async" width="800" height="533" sizes="(max-width: 640px) 90vw, (max-width: 900px) 600px, (max-width: 1279px) 45vw, 29vw" /> : <div class="image-placeholder">相片整理中</div>}
      {statusBadge ? (
        <span class={`vehicle-badge${vehicle.status === 'sold' ? ' vehicle-badge--sold' : ''}`}>{statusBadge}</span>
      ) : vehicle.monthlyRecommended ? (
        <span class="vehicle-badge">本月推薦</span>
      ) : null}
    </div>
      <div class="vehicle-card__body">
        <div class="vehicle-card__eyebrow-row">
          <BrandIcon iconUrl={vehicle.brandIconUrl} name={vehicle.brandDisplayName} alt="" size={18} />
          <p class="eyebrow">{vehicle.brandDisplayName}</p>
        </div>
        <h2>{vehicle.cardTitle}</h2>
        <p class="vehicle-card__price">價格請洽</p>
        <ul class="spec-list" aria-label="車輛資訊">
          {specs.map((spec) => (
            <li class:list={['spec-item', spec.label === '年份' && 'spec-item--year', spec.label === '里程' && 'spec-item--mileage', spec.label === '車況' && 'spec-item--condition']}>
              <span class="spec-icon" aria-hidden="true">
                {spec.icon === 'calendar' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 3v3M17 3v3M4.5 9.5h15M6.5 5.5h11A2.5 2.5 0 0 1 20 8v9.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5V8a2.5 2.5 0 0 1 2.5-2.5Z" />
                  </svg>
                )}
                {spec.icon === 'gauge' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4.8 16.6a8 8 0 1 1 14.4 0M12 12.8l4.2-4.2M7.6 15.8h8.8" />
                  </svg>
                )}
                {spec.icon === 'car' && (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 14l1.6-4.2A2.8 2.8 0 0 1 9.2 8h5.6a2.8 2.8 0 0 1 2.6 1.8L19 14M4.5 14h15v4.2H17M7 18.2H5.5M7.2 14.2h.1M16.7 14.2h.1M7 18.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6ZM17 18.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z" />
                  </svg>
                )}
              </span>
              <span class="spec-copy" title={spec.label === '車況' ? String(spec.value || '') : undefined}>
                <span>{spec.label}</span>
                <strong class:list={[spec.label === '年份' && 'spec-value--year', spec.label === '車況' && 'spec-value--condition', spec.label === '里程' && /\u00a0km$/.test(String(spec.value || '')) && 'spec-value--mileage']} title={spec.label === '車況' ? String(spec.value || '—') : undefined}>{spec.value || '—'}</strong>
              </span>
            </li>
          ))}
        </ul>
    </div>
  </a>
  <ShareButton class="vehicle-share" title={vehicle.title} url={`/cars/${vehicle.slug}`} text={shareText} />
  <div class="card-footer">
    <a class="vehicle-card__details" href={`/cars/${vehicle.slug}`}>查看詳情</a>
    {compareEnabled && (
      <button
        type="button"
        class="compare-btn"
        data-compare-slug={vehicle.slug}
        data-compare-title={vehicle.cardTitle}
        data-compare-year={vehicle.year}
        data-compare-thumb={vehicle.coverImage?.thumbUrl || vehicle.coverImage?.url || ''}
        aria-label={`加入比較：${vehicle.title}`}
        aria-pressed="false"
      >
        <svg class="compare-btn__icon" viewBox="0 0 20 20" aria-hidden="true"><path class="compare-btn__plus" d="M10 4v12M4 10h12" /><path class="compare-btn__check" d="m4 10 4 4 8-8" /></svg>
        <span class="compare-btn__label">比較</span>
      </button>
    )}
  </div>
</article>

<style>
  .compare-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex: 0 0 auto;
    min-width: 6rem;
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--accent-strong);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .compare-btn:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); }
  .compare-btn[aria-pressed="true"] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--surface)); }
  .compare-btn__icon { width: 1rem; height: 1rem; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  .compare-btn__check, .compare-btn[aria-pressed="true"] .compare-btn__plus { display: none; }
  .compare-btn[aria-pressed="true"] .compare-btn__check { display: block; }
</style>
