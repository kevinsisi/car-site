---
import type { HeroVideo } from '@/lib/settings';
interface Props {
  videos: HeroVideo[];
  title?: string;
  variant?: 'default' | 'top-strip';
}
const { videos, title, variant = 'default' } = Astro.props;
if (!videos.length) return;
const isTopStrip = variant === 'top-strip';

function youtubeId(url: string): string | null {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/);
  return match?.[1] ?? null;
}

function youtubeEmbedParams(videoId: string | null): string {
  const params = new URLSearchParams({
    rel: '0',
    mute: '1',
    playsinline: '1',
    enablejsapi: '1',
  });
  if (isTopStrip && videoId) {
    params.set('autoplay', '1');
    params.set('controls', '0');
    params.set('modestbranding', '1');
    params.set('fs', '0');
    params.set('disablekb', '1');
    params.set('iv_load_policy', '3');
    if (videos.length === 1) {
      // Single banner video loops itself; with multiple videos the video must
      // be allowed to end so we can advance to the next one.
      params.set('loop', '1');
      params.set('playlist', videoId);
    }
  }
  return params.toString();
}

function stripPosterStyle(video: HeroVideo, videoId: string | null): string | undefined {
  if (video.thumbnailUrl) return `background-image:url('${video.thumbnailUrl}')`;
  if (videoId) {
    // No custom thumbnail — fall back to YouTube's own stills (maxres first,
    // hq as a guaranteed-to-exist backup layer).
    return `background-image:url('https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg'), url('https://i.ytimg.com/vi/${videoId}/hqdefault.jpg')`;
  }
  return undefined;
}

---

{videos.length > 0 && (
  <section class:list={['video-carousel', { 'video-carousel--top-strip': variant === 'top-strip', 'reveal-section': variant !== 'top-strip' }]}>
    {title && <h2 class="video-carousel__title">{title}</h2>}
    <div class="video-carousel__stage" data-vcarousel>
      {videos.map((video, index) => {
        const videoId = video.type === 'youtube' ? youtubeId(video.url) : null;
        const youtubeParams = youtubeEmbedParams(videoId);
        return (
        <div class={`video-carousel__item${index === 0 ? ' is-active' : ''}`} data-vitem={index}>
          {video.type === 'youtube' && videoId && isTopStrip ? (
            <div
              class="strip-embed"
              data-embed-src={`https://www.youtube.com/embed/${videoId}?${youtubeParams}`}
              data-embed-title={video.label || `影片 ${index + 1}`}
              style={stripPosterStyle(video, videoId)}
            ></div>
          ) : video.type === 'youtube' && videoId ? (
            <iframe
              src={`https://www.youtube.com/embed/${videoId}?${youtubeParams}`}
              title={video.label || `影片 ${index + 1}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              loading={index === 0 ? 'eager' : 'lazy'}
            ></iframe>
          ) : video.type === 'mp4' ? (
            <video
              src={video.url}
              poster={video.thumbnailUrl || undefined}
              controls={!isTopStrip}
              autoplay={isTopStrip}
              muted
              loop={isTopStrip && videos.length === 1}
              playsinline={isTopStrip}
              preload={isTopStrip ? 'auto' : 'none'}
              title={video.label || `影片 ${index + 1}`}
            ></video>
          ) : null}
          {video.label && <p class="video-carousel__label">{video.label}</p>}
        </div>
      );})}
    </div>

    {videos.length > 1 && !isTopStrip && (
      <div class="video-carousel__controls">
        <button type="button" data-vcarousel-prev aria-label="上一段影片">‹</button>
        <div class="video-carousel__dots">
          {videos.map((_, i) => (
            <button
              type="button"
              class={`vdot${i === 0 ? ' is-active' : ''}`}
              data-vcarousel-dot={i}
              aria-label={`跳到影片 ${i + 1}`}
            ></button>
          ))}
        </div>
        <button type="button" data-vcarousel-next aria-label="下一段影片">›</button>
      </div>
    )}
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-vcarousel]').forEach((stage) => {
    const section = stage.closest('.video-carousel');
    const items = Array.from(stage.querySelectorAll<HTMLElement>('[data-vitem]'));
    const dots = Array.from(section?.querySelectorAll<HTMLElement>('[data-vcarousel-dot]') ?? []);
    let current = 0;

    const syncVideoPlayback = () => {
      items.forEach((item, index) => {
        const video = item.querySelector('video');
        const iframe = item.querySelector<HTMLIFrameElement>('iframe[src*="youtube.com/embed"]');
        if (video) {
          video.muted = true;
          video.defaultMuted = true;
          video.volume = 0;
        }
        if (iframe?.contentWindow) {
          iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'mute', args: [] }), '*');
          iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'setVolume', args: [0] }), '*');
          iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: index === current ? 'playVideo' : 'pauseVideo', args: [] }), '*');
        }
        if (!video) return;
        if (index === current) {
          video.play().catch(() => undefined);
        } else {
          video.pause();
          video.currentTime = 0;
        }
      });
    };

    // Banner (top-strip) YouTube embeds start as a poster div and only get the
    // iframe injected after the page has finished loading, so the hero video
    // never competes with first paint. Users who prefer reduced motion keep
    // the static poster.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const injectEmbed = (item: HTMLElement | undefined) => {
      if (!item || prefersReducedMotion) return;
      const holder = item.querySelector<HTMLElement>('.strip-embed');
      if (!holder || holder.querySelector('iframe') || !holder.dataset.embedSrc) return;
      const iframe = document.createElement('iframe');
      iframe.src = holder.dataset.embedSrc;
      iframe.title = holder.dataset.embedTitle || '';
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      iframe.setAttribute('tabindex', '-1');
      iframe.setAttribute('aria-hidden', 'true');
      iframe.addEventListener('load', () => {
        // Subscribe to player events (needed to detect when a video ends).
        iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 'strip', channel: 'widget' }), '*');
        syncVideoPlayback();
        // YouTube paints its branding/controls during the first moments of
        // autoplay; keep the poster on top until that chrome has faded.
        window.setTimeout(() => iframe.classList.add('is-ready'), 2200);
      });
      holder.appendChild(iframe);
    };

    const show = (index: number) => {
      items[current]?.classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = (index + items.length) % items.length;
      items[current]?.classList.add('is-active');
      dots[current]?.classList.add('is-active');
      injectEmbed(items[current]);
      syncVideoPlayback();
    };

    items.forEach((item) => {
      item.querySelector('iframe[src*="youtube.com/embed"]')?.addEventListener('load', syncVideoPlayback);
    });

    if (document.readyState === 'complete') {
      injectEmbed(items[current]);
    } else {
      window.addEventListener('load', () => injectEmbed(items[current]), { once: true });
    }

    // Banner playlist behaviour: when the active video ends, advance to the
    // next one (wrapping back to the first). A single video self-loops via
    // the loop/playlist embed params instead.
    if (section?.classList.contains('video-carousel--top-strip') && items.length > 1) {
      window.addEventListener('message', (event) => {
        if (typeof event.data !== 'string') return;
        let originHost = '';
        try {
          originHost = new URL(event.origin).hostname;
        } catch {
          return;
        }
        if (!/(^|\.)youtube(-nocookie)?\.com$/.test(originHost)) return;
        const activeIframe = items[current]?.querySelector('iframe');
        if (!activeIframe || event.source !== activeIframe.contentWindow) return;
        try {
          const data = JSON.parse(event.data);
          // The widget protocol reports state either as a dedicated
          // onStateChange event or inside infoDelivery payloads; 0 = ended.
          const ended =
            (data.event === 'onStateChange' && data.info === 0) ||
            (data.event === 'infoDelivery' && data.info?.playerState === 0);
          if (ended) show(current + 1);
        } catch {
          /* not a player event */
        }
      });
      items.forEach((item) => {
        item.querySelector('video')?.addEventListener('ended', () => show(current + 1));
      });
    }

    syncVideoPlayback();

    section?.querySelector('[data-vcarousel-prev]')?.addEventListener('click', () => show(current - 1));
    section?.querySelector('[data-vcarousel-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  });
</script>

<style>
.video-carousel { width: 100%; margin: var(--section-gap, 3rem) 0; }
.video-carousel--top-strip { position: relative; margin: 0; background: #000; }
.video-carousel__title { text-align: center; margin-bottom: 1.5rem; }
.video-carousel__stage { position: relative; }
.video-carousel__item { display: none; }
.video-carousel__item.is-active { display: block; }
.video-carousel__item iframe,
.video-carousel__item video {
  width: 100%;
  aspect-ratio: 16/9;
  border: 0;
  border-radius: var(--card-radius, 8px);
  background: #000;
  display: block;
  object-fit: cover;
}
.video-carousel--top-strip { --strip-h: clamp(22rem, 37vw, 30rem); }
.video-carousel--top-strip .video-carousel__item {
  position: relative;
  height: var(--strip-h);
  overflow: hidden;
}
.video-carousel--top-strip .video-carousel__item video {
  width: 100%;
  height: var(--strip-h);
  aspect-ratio: auto;
  object-fit: cover;
  border-radius: 0;
  pointer-events: none;
  user-select: none;
}
/* Poster shown immediately; iframe injected after page load. */
.strip-embed {
  position: absolute;
  inset: 0;
  background: #000 center / cover no-repeat;
}
/* Oversize the YouTube frame ~35% beyond cover so its title bar and watermark
   sit outside the cropped viewport — the user only sees clean motion. */
.strip-embed :global(iframe) {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: max(calc(100% * var(--strip-zoom, 1)), calc(var(--strip-h) * 2.4));
  height: max(calc(var(--strip-h) * 1.35), calc(56.25vw * var(--strip-zoom, 1)));
  border: 0;
  pointer-events: none;
  user-select: none;
  /* Hidden behind the poster until YouTube's startup chrome has faded. */
  opacity: 0;
  transition: opacity 600ms ease;
}
.strip-embed :global(iframe.is-ready) {
  opacity: 1;
}
.video-carousel--top-strip .video-carousel__label { display: none; }
.video-carousel--top-strip .video-carousel__controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0.35rem;
  margin: 0;
  color: #fff;
  pointer-events: none;
}
.video-carousel--top-strip .video-carousel__controls button { pointer-events: auto; color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,0.8); }
.video-carousel__label { text-align: center; margin-top: 0.75rem; font-size: 0.9rem; color: var(--muted, #777); }
.video-carousel__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1rem; }
.video-carousel__controls button { background: none; border: 0; font-size: 1.5rem; cursor: pointer; padding: 0.25em 0.5em; color: inherit; opacity: 0.7; }
.video-carousel__controls button:hover { opacity: 1; }
.video-carousel__dots { display: flex; gap: 0.5rem; }
.vdot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted, #aaa); border: 0; padding: 0; cursor: pointer; transition: background 0.15s; }
.vdot.is-active { background: var(--accent, #0066cc); }

@media (max-width: 900px) {
  /* Mobile YouTube chrome (title bar / watermark) is taller relative to the
     short strip — zoom harder so it stays cropped out of view. */
  .video-carousel--top-strip { --strip-h: clamp(11.5rem, 52vw, 14rem); --strip-zoom: 1.6; }
}
</style>
