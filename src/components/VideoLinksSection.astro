---
import type { VideoLinkView } from '@/lib/video-links';
interface Props {
  links: VideoLinkView[];
  sectionTitle?: string;
}
const { links, sectionTitle = '精選影片' } = Astro.props;
const instagramLinks = links.filter((link) => instagramEmbedUrl(link.url));

function instagramEmbedUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (!/(^|\.)instagram\.com$/i.test(parsed.hostname)) return null;
    const match = parsed.pathname.match(/^\/(p|reel|tv)\/([^/?#]+)/i);
    if (!match) return null;
    return `https://www.instagram.com/${match[1].toLowerCase()}/${match[2]}/embed`;
  } catch {
    return null;
  }
}
---
{instagramLinks.length > 0 && (
  <section class="video-links reveal-section">
    <div class="video-links__header">
      <div>
        <p class="eyebrow">{sectionTitle}</p>
        <h2>Instagram 精選影片</h2>
      </div>
      <div class="video-links__controls" aria-label="影片輪播控制">
        <button type="button" data-video-links-prev aria-label="上一支影片">‹</button>
        <button type="button" data-video-links-next aria-label="下一支影片">›</button>
      </div>
    </div>
    <ul class="video-links__grid" role="list" data-video-links-track>
      {instagramLinks.map((link, index) => {
        const instagramEmbed = instagramEmbedUrl(link.url);
        const showInstagramEmbed = instagramEmbed && (!link.thumbnailUrl || link.thumbnailUrl.includes('/video-thumbnails/'));
        return (
        <li data-video-links-item>
          <div class="video-links__item">
            <span class="video-links__index">{String(index + 1).padStart(2, '0')}</span>
            <div class="video-links__thumb">
              {showInstagramEmbed ? (
                <iframe
                  src={instagramEmbed}
                  title={link.title || 'Instagram 影片'}
                  loading="lazy"
                  allowtransparency="true"
                  allow="encrypted-media; clipboard-write"
                ></iframe>
              ) : link.thumbnailUrl ? (
                <img src={link.thumbnailUrl} alt={link.title} loading="lazy" decoding="async" />
              ) : (
                <div class="video-links__thumb-placeholder">
                  <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M5 3l14 9-14 9V3z" fill="currentColor" /></svg>
                </div>
              )}
              {!showInstagramEmbed && <span class="video-links__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="36" height="36"><circle cx="12" cy="12" r="11" fill="rgba(0,0,0,0.5)"/><path d="M10 8l6 4-6 4V8z" fill="#fff" /></svg>
              </span>}
            </div>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="video-links__title">{link.title || '在 Instagram 查看影片'}</a>
          </div>
        </li>
      )})}
    </ul>
    <div class="video-links__dots" aria-hidden="true">
      {instagramLinks.map((_, index) => <span class={index === 0 ? 'is-active' : ''}></span>)}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.video-links').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-video-links-track]');
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-video-links-item]'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('.video-links__dots span'));
    if (!track || !items.length) return;
    let lastFrame = performance.now();

    const activeIndex = () => {
      const left = track.scrollLeft;
      return items.reduce((closest, item, index) => {
        const currentDistance = Math.abs(item.offsetLeft - left);
        const closestDistance = Math.abs(items[closest].offsetLeft - left);
        return currentDistance < closestDistance ? index : closest;
      }, 0);
    };

    const sync = () => {
      const index = activeIndex();
      items.forEach((item, i) => item.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    const scrollToIndex = (index: number) => {
      const target = items[(index + items.length) % items.length];
      track.scrollTo({ left: target.offsetLeft, behavior: 'auto' });
    };

    // Auto-scroll pauses the moment the user touches/clicks the carousel and
    // stays paused until they deliberately swipe it again:
    //   running → (pointerdown / iframe focus) → paused
    //   paused  → gesture ends + scrolling settles → armed
    //   armed   → next user scroll → running
    let mode: 'running' | 'paused' | 'armed' = 'running';
    let gestureActive = false;
    let settleTimer: number | undefined;

    const pauseAuto = () => {
      mode = 'paused';
      if (settleTimer) clearTimeout(settleTimer);
    };
    const armAfterSettle = () => {
      if (settleTimer) clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        if (mode === 'paused' && !gestureActive) mode = 'armed';
      }, 300);
    };

    track.addEventListener('pointerdown', () => {
      gestureActive = true;
      pauseAuto();
    }, { passive: true });
    const endGesture = () => {
      if (!gestureActive) return;
      gestureActive = false;
      if (mode === 'paused') armAfterSettle();
    };
    window.addEventListener('pointerup', endGesture, { passive: true });
    window.addEventListener('pointercancel', endGesture, { passive: true });
    // Instagram embeds swallow pointer events; a click inside one focuses the
    // iframe and blurs the window — treat that as the pause click.
    window.addEventListener('blur', () => {
      const active = document.activeElement;
      if (active instanceof HTMLIFrameElement && track.contains(active)) {
        pauseAuto();
        armAfterSettle();
      }
    });

    const tick = (now: number) => {
      const delta = now - lastFrame;
      lastFrame = now;
      if (!document.hidden && items.length > 1 && mode === 'running') {
        const maxScroll = track.scrollWidth - track.clientWidth;
        track.scrollLeft = track.scrollLeft >= maxScroll - 2 ? 0 : track.scrollLeft + delta * 0.06;
        sync();
      }
      requestAnimationFrame(tick);
    };

    section.querySelector('[data-video-links-prev]')?.addEventListener('click', () => {
      scrollToIndex(activeIndex() - 1);
    });
    section.querySelector('[data-video-links-next]')?.addEventListener('click', () => {
      scrollToIndex(activeIndex() + 1);
    });
    track.addEventListener('scroll', () => {
      if (mode === 'armed') {
        mode = 'running';
      } else if (mode === 'paused' && !gestureActive) {
        // momentum from the pausing swipe — keep waiting for it to settle
        armAfterSettle();
      }
      requestAnimationFrame(sync);
    }, { passive: true });
    sync();
    requestAnimationFrame(tick);
  });
</script>

<style>
.video-links { margin: var(--section-gap, 4rem) 0; padding: clamp(1.1rem, 3vw, 2rem) 0; overflow: hidden; }
.video-links__header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
.video-links .eyebrow { margin: 0 0 0.35rem; }
.video-links h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; }
.video-links__controls { display: flex; gap: 0.45rem; }
.video-links__controls button { width: 2.4rem; height: 2.4rem; border: 1px solid color-mix(in srgb, var(--line) 72%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--surface) 82%, transparent); color: var(--accent-strong); font-size: 1.5rem; line-height: 1; }
.video-links__controls button:hover { transform: translateY(-1px); background: var(--surface); border-color: color-mix(in srgb, var(--accent) 54%, var(--line)); }
.video-links__grid {
  display: flex;
  gap: clamp(0.85rem, 2vw, 1.35rem);
  list-style: none;
  padding: 0 clamp(1.25rem, 5vw, 6rem) 0.7rem; margin: 0 calc(-1 * clamp(1.25rem, 5vw, 6rem));
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.video-links__grid::-webkit-scrollbar { display: none; }
.video-links__grid > li { flex: 0 0 min(20rem, 76vw); }
@media (min-width: 900px) { .video-links__grid > li { flex-basis: min(22rem, 25vw); } }
.video-links__item { position: relative; display: grid; gap: 0.7rem; color: inherit; opacity: 0.82; transform: scale(0.975); transition: opacity 220ms ease, transform 220ms ease; }
.video-links__grid > li.is-active .video-links__item,
.video-links__item:hover { opacity: 1; transform: scale(1); }
.video-links__index { position: absolute; z-index: 2; top: 0.7rem; left: 0.7rem; min-width: 2.2rem; height: 1.65rem; display: inline-grid; place-items: center; border: 1px solid rgba(255,255,255,0.22); border-radius: 999px; background: rgba(10, 12, 18, 0.48); color: #fff; font-size: 0.74rem; font-weight: 850; letter-spacing: 0.08em; backdrop-filter: blur(14px); }
.video-links__thumb {
  position: relative;
  aspect-ratio: 9/16;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
  border-radius: 1.35rem;
  background: #050507;
  box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.24);
}
.video-links__thumb::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0.12), transparent 28%, rgba(0,0,0,0.16)); }
.video-links__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.24s; }
.video-links__thumb iframe { width: 100%; height: 100%; border: 0; display: block; background: #fff; }
.video-links__item:hover .video-links__thumb img { transform: scale(1.04); }
.video-links__thumb-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--muted, #777); }
.video-links__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.video-links__title { display: block; color: var(--muted); text-decoration: none; font-size: 0.86rem; font-weight: 760; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.video-links__title:hover { color: var(--accent-strong); }
.video-links__dots { display: flex; justify-content: center; gap: 0.35rem; margin-top: 0.8rem; }
.video-links__dots span { width: 0.42rem; height: 0.42rem; border-radius: 999px; background: color-mix(in srgb, var(--muted) 36%, transparent); transition: width 180ms ease, background-color 180ms ease; }
.video-links__dots span.is-active { width: 1.5rem; background: var(--accent); }

@media (max-width: 900px) {
  .video-links__header { align-items: center; }
  .video-links__controls button { width: 2.2rem; height: 2.2rem; }
  .video-links__grid > li { flex-basis: min(17.5rem, 72vw); }
}
</style>
