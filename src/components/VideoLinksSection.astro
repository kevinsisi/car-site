---
import type { VideoLinkView } from '@/lib/video-links';
interface Props {
  links: VideoLinkView[];
  sectionTitle?: string;
}
const { links, sectionTitle = '精選影片' } = Astro.props;
const instagramLinks = links.filter((link) => instagramEmbedUrl(link.url));

function instagramEmbedUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (!/(^|\.)instagram\.com$/i.test(parsed.hostname)) return null;
    const match = parsed.pathname.match(/^\/(p|reel|tv)\/([^/?#]+)/i);
    if (!match) return null;
    return `https://www.instagram.com/${match[1].toLowerCase()}/${match[2]}/embed`;
  } catch {
    return null;
  }
}
---
{instagramLinks.length > 0 && (
  <section class="video-links reveal-section">
    <div class="video-links__header">
      <div>
        <p class="eyebrow">{sectionTitle}</p>
        <h2>Instagram 精選影片</h2>
      </div>
    </div>
    <div class="video-links__stage">
      <ul class="video-links__grid" role="list" data-video-links-track>
        {instagramLinks.map((link, index) => {
          const instagramEmbed = instagramEmbedUrl(link.url);
          return (
          <li data-video-links-item>
            <div class="video-links__item">
              <span class="video-links__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="video-links__thumb" data-video-embed-shell>
                {link.thumbnailUrl ? (
                  <>
                    <img src={link.thumbnailUrl} alt={link.title} loading="lazy" decoding="async" />
                    <a class="video-links__play" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`在 Instagram 開啟 ${link.title || '精選好車'}`}>
                      <svg viewBox="0 0 24 24" width="36" height="36"><circle cx="12" cy="12" r="11" fill="rgba(0,0,0,0.5)"/><path d="M10 8l6 4-6 4V8z" fill="#fff" /></svg>
                    </a>
                  </>
                ) : instagramEmbed ? (
                  <>
                    <iframe
                      src={instagramEmbed}
                      title={link.title || '精選好車'}
                      loading="lazy"
                      scrolling="no"
                      allowtransparency="true"
                      allow="encrypted-media; clipboard-write"
                    ></iframe>
                    <button class="video-links__tap-shield" type="button" aria-label={`暫停輪播並啟用 ${link.title || 'Instagram 影片'}`}></button>
                  </>
                ) : (
                  <a class="video-links__thumb-placeholder" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`在 Instagram 開啟 ${link.title || '精選好車'}`}>
                    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true"><path d="M5 3l14 9-14 9V3z" fill="currentColor" /></svg>
                  </a>
                )}
              </div>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="video-links__title">{link.title || '精選好車'}</a>
            </div>
          </li>
        )})}
      </ul>
      <div class="video-links__controls" aria-label="影片輪播控制">
        <button class="video-links__control video-links__control--prev" type="button" data-video-links-prev aria-label="上一支影片">‹</button>
        <button class="video-links__control video-links__control--next" type="button" data-video-links-next aria-label="下一支影片">›</button>
      </div>
    </div>
    <div class="video-links__dots" aria-hidden="true">
      {instagramLinks.map((_, index) => <span class={index === 0 ? 'is-active' : ''}></span>)}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.video-links').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-video-links-track]');
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-video-links-item]'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('.video-links__dots span'));
    if (!track || !items.length) return;
    let lastFrame = performance.now();

    const activeIndex = () => {
      const viewCenter = track.scrollLeft + track.clientWidth / 2;
      return items.reduce((closest, item, index) => {
        const itemCenter = item.offsetLeft + item.offsetWidth / 2;
        const currentDistance = Math.abs(itemCenter - viewCenter);
        const closestItem = items[closest];
        const closestCenter = closestItem.offsetLeft + closestItem.offsetWidth / 2;
        const closestDistance = Math.abs(closestCenter - viewCenter);
        return currentDistance < closestDistance ? index : closest;
      }, 0);
    };

    const sync = () => {
      const index = activeIndex();
      items.forEach((item, i) => item.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    const scrollToIndex = (index: number) => {
      const target = items[(index + items.length) % items.length];
      const itemCenter = target.offsetLeft + target.offsetWidth / 2;
      track.scrollTo({ left: itemCenter - track.clientWidth / 2, behavior: 'auto' });
    };

    // Click/tap should pause the carousel. Only a real drag/swipe resumes it.
    let mode: 'running' | 'paused' = 'running';
    let gestureActive = false;
    let gestureMoved = false;
    let gestureStart: { x: number; y: number } | null = null;
    let pausedScrollLeft = 0;
    let resumeTimer: number | undefined;

    const pauseAuto = () => {
      mode = 'paused';
      pausedScrollLeft = track.scrollLeft;
      if (resumeTimer) clearTimeout(resumeTimer);
    };
    const restoreTapShields = () => {
      track.querySelectorAll<HTMLElement>('.video-links__tap-shield').forEach((shield) => {
        shield.hidden = false;
      });
    };
    const resumeAfterSwipe = () => {
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        if (!gestureActive) mode = 'running';
      }, 450);
    };

    track.addEventListener('pointerdown', (event) => {
      gestureActive = true;
      gestureMoved = false;
      gestureStart = { x: event.clientX, y: event.clientY };
      pauseAuto();
    }, { passive: true });
    track.addEventListener('pointermove', (event) => {
      if (!gestureStart) return;
      if (Math.hypot(event.clientX - gestureStart.x, event.clientY - gestureStart.y) > 12) {
        gestureMoved = true;
      }
    }, { passive: true });
    track.addEventListener('click', (event) => {
      if (!gestureMoved && event.target instanceof Element && event.target.closest('[data-video-links-item]')) {
        pauseAuto();
      }
    }, { capture: true });
    track.querySelectorAll<HTMLButtonElement>('.video-links__tap-shield').forEach((shield) => {
      shield.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        pauseAuto();
        shield.hidden = true;
      });
    });
    const endGesture = () => {
      if (!gestureActive) return;
      gestureActive = false;
      gestureStart = null;
      if (gestureMoved) resumeAfterSwipe();
    };
    window.addEventListener('pointerup', endGesture, { passive: true });
    window.addEventListener('pointercancel', endGesture, { passive: true });
    window.addEventListener('blur', () => {
      const active = document.activeElement;
      if (active instanceof HTMLIFrameElement && track.contains(active)) {
        pauseAuto();
      }
    });
    const tick = (now: number) => {
      const delta = now - lastFrame;
      lastFrame = now;
      if (!document.hidden && items.length > 1 && mode === 'running') {
        const maxScroll = track.scrollWidth - track.clientWidth;
        track.scrollLeft = track.scrollLeft >= maxScroll - 2 ? 0 : track.scrollLeft + delta * 0.06;
        sync();
      }
      requestAnimationFrame(tick);
    };

    section.querySelector('[data-video-links-prev]')?.addEventListener('click', () => {
      scrollToIndex(activeIndex() - 1);
      restoreTapShields();
      resumeAfterSwipe();
    });
    section.querySelector('[data-video-links-next]')?.addEventListener('click', () => {
      scrollToIndex(activeIndex() + 1);
      restoreTapShields();
      resumeAfterSwipe();
    });
    track.addEventListener('scroll', () => {
      if (mode === 'paused' && !gestureActive && Math.abs(track.scrollLeft - pausedScrollLeft) > 12) {
        restoreTapShields();
        resumeAfterSwipe();
      }
      requestAnimationFrame(sync);
    }, { passive: true });
    sync();
    requestAnimationFrame(tick);
  });
</script>

<style>
.video-links { margin: var(--section-gap, 4rem) 0; padding: clamp(1.1rem, 3vw, 2rem) 0; overflow: hidden; }
.video-links__header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
.video-links .eyebrow { margin: 0 0 0.35rem; }
.video-links h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; }
.video-links__stage { position: relative; }
.video-links__controls { pointer-events: none; position: absolute; inset: 0; z-index: 4; display: flex; align-items: center; justify-content: space-between; }
.video-links__control { pointer-events: auto; width: 2.8rem; height: 2.8rem; border: 1px solid color-mix(in srgb, var(--line) 72%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--surface) 86%, transparent); color: var(--accent-strong); font-size: 1.65rem; line-height: 1; box-shadow: 0 0.9rem 2.2rem rgba(0, 0, 0, 0.16); backdrop-filter: blur(14px); }
.video-links__control:hover { transform: translateY(-1px); background: var(--surface); border-color: color-mix(in srgb, var(--accent) 54%, var(--line)); }
.video-links__control--prev { margin-left: clamp(0.45rem, 1.4vw, 1.1rem); }
.video-links__control--next { margin-right: clamp(0.45rem, 1.4vw, 1.1rem); }
.video-links__grid {
  display: flex;
  gap: clamp(0.85rem, 2vw, 1.35rem);
  list-style: none;
  padding: 0 clamp(1.25rem, 5vw, 6rem) 0.7rem; margin: 0 calc(-1 * clamp(1.25rem, 5vw, 6rem));
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.video-links__grid::-webkit-scrollbar { display: none; }
.video-links__grid > li { flex: 0 0 min(20rem, 76vw); }
@media (min-width: 900px) { .video-links__grid > li { flex-basis: min(22rem, 25vw); } }
.video-links__item { position: relative; display: grid; gap: 0.7rem; color: inherit; opacity: 0.55; transform: scale(0.82); transition: transform 300ms ease, opacity 300ms ease; }
.video-links__grid > li.is-active .video-links__item { opacity: 1; transform: scale(1); }
.video-links__item:hover { opacity: 0.8; }
.video-links__index { position: absolute; z-index: 2; top: 0.7rem; left: 0.7rem; min-width: 2.2rem; height: 1.65rem; display: inline-grid; place-items: center; border: 1px solid rgba(255,255,255,0.22); border-radius: 999px; background: rgba(10, 12, 18, 0.48); color: #fff; font-size: 0.74rem; font-weight: 850; letter-spacing: 0.08em; backdrop-filter: blur(14px); }
.video-links__thumb {
  position: relative;
  display: block;
  aspect-ratio: 9/16;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
  border-radius: 1.35rem;
  background: #050507;
  box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.24);
}
.video-links__thumb::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0.12), transparent 28%, rgba(0,0,0,0.16)); }
.video-links__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.24s; }
.video-links__thumb iframe {
  position: absolute;
  z-index: 1;
  width: 130%;
  margin-left: -15%;
  height: calc(100% + 3.4rem);
  margin-top: -3.4rem;
  border: 0;
  display: block;
  background: #fff;
  overflow: hidden;
}
.video-links__item:hover .video-links__thumb img { transform: scale(1.04); }
.video-links__thumb-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #fff; background: linear-gradient(135deg, #833ab4, #fd1d1d 48%, #fcb045); }
.video-links__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.video-links__tap-shield { position: absolute; inset: 0; z-index: 3; display: block; width: 100%; height: 100%; border: 0; padding: 0; background: transparent; cursor: pointer; }
.video-links__tap-shield[hidden] { display: none; }
.video-links__title { display: block; color: var(--muted); text-decoration: none; font-size: 0.86rem; font-weight: 760; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.video-links__title:hover { color: var(--accent-strong); }
.video-links__dots { display: flex; justify-content: center; gap: 0.35rem; margin-top: 0.8rem; }
.video-links__dots span { width: 0.42rem; height: 0.42rem; border-radius: 999px; background: color-mix(in srgb, var(--muted) 36%, transparent); transition: width 180ms ease, background-color 180ms ease; }
.video-links__dots span.is-active { width: 1.5rem; background: var(--accent); }

@media (max-width: 900px) {
  .video-links__header { align-items: center; }
  .video-links__controls { display: none; }
  .video-links__grid > li { flex-basis: min(17.5rem, 72vw); }
}

</style>
