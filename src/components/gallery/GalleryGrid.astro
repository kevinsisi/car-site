---
import type { VehicleImageView } from '@/lib/vehicles';
interface Props {
  images: VehicleImageView[];
  title: string;
}
const { images, title } = Astro.props;
const INITIAL = 6;
const hasMore = images.length > INITIAL;
---
{images.length > 0 && (
  <section class="gallery-grid reveal-section" aria-label="車輛照片">
    <p class="gallery-grid__count eyebrow">共 {images.length} 張</p>
    <div class="gallery-grid__list" id="gallery-grid-list">
      {images.map((image, index) => (
        <button
          class={`gallery-grid__item${index >= INITIAL ? ' gallery-grid__item--hidden' : ''}`}
          type="button"
          data-gallery-index={index}
          aria-label={`開啟第 ${index + 1} 張大圖`}
        >
          <img
            src={index < INITIAL ? image.thumbUrl : undefined}
            data-src={index >= INITIAL ? image.thumbUrl : undefined}
            alt={image.alt || `${title} 圖片 ${index + 1} / ${images.length}`}
            loading="lazy"
            decoding="async"
            width="400" height="300"
          />
          <span class="gallery-grid__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke="currentColor" stroke-width="2" fill="none" /></svg>
          </span>
        </button>
      ))}
    </div>
    {hasMore && (
      <button class="gallery-grid__more" id="gallery-more-btn" type="button">
        顯示全部 {images.length} 張 ▾
      </button>
    )}
  </section>
)}

<script>
  const btn = document.getElementById('gallery-more-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      const hidden = document.querySelectorAll<HTMLElement>('.gallery-grid__item--hidden');
      hidden.forEach((el) => {
        // Load deferred src
        const img = el.querySelector<HTMLImageElement>('img');
        if (img && img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; }
        el.classList.remove('gallery-grid__item--hidden');
      });
      btn.remove();
    });
  }
</script>

<style>
.gallery-grid { width: 100%; max-width: 100%; min-width: 0; overflow: hidden; }
.gallery-grid__count { margin-bottom: 1rem; }
.gallery-grid__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; min-width: 0; }
@media (max-width: 640px) { .gallery-grid__list { grid-template-columns: repeat(2, 1fr); } }
.gallery-grid__item { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: 4px; border: 0; padding: 0; background: var(--surface-soft); cursor: zoom-in; }
.gallery-grid__item--hidden { display: none; }
.gallery-grid__item img { width: 100%; height: 100%; object-fit: cover; }
.gallery-grid__zoom { position: absolute; bottom: 6px; right: 6px; color: #fff; opacity: 0.8; }
.gallery-grid__more {
  display: block; width: 100%; margin-top: 1rem;
  padding: 0.6rem; border: 1px solid var(--line, #ddd); border-radius: 6px;
  background: none; cursor: pointer; font-size: 0.875rem; color: var(--muted, #666);
  transition: background 0.15s;
}
.gallery-grid__more:hover { background: var(--surface-soft, #f5f5f5); }
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .gallery-grid__item img { transition: transform 0.2s ease; }
  .gallery-grid__item:hover img { transform: scale(1.03); }
}
</style>
