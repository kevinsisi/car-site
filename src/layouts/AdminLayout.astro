---
import '@/styles/admin.css';
import { getSettings } from '@/lib/settings';
import { siteIconHref } from '@/lib/site-icon';
import { PERMISSIONS, hasPermission } from '@/lib/permissions';
import { resolveFrontFeatures } from '@/lib/front-features';
import { FEATURE_ANALYTICS, hasFeature } from '@/lib/features';
import { styleVars, styles } from '@/lib/theme';
import type { AdminUserSession } from '@/lib/auth';

interface Props {
  user: AdminUserSession;
  title?: string;
}

const { user, title = '後台管理' } = Astro.props;
const pathname = Astro.url.pathname;
const settings = await getSettings();
const features = resolveFrontFeatures(settings);
const siteIconUrl = siteIconHref(settings);
const activeStyle = styles[settings.activeStyle];

const perm = user.permissions;
const isSuper = user.role === 'superadmin';

const isActive = (href: string) => {
  if (href === '/admin') return pathname === '/admin' || pathname === '/admin/';
  return pathname === href || pathname.startsWith(href + '/');
};

const settingsPerms = [
  PERMISSIONS.SETTINGS_BASIC,
  PERMISSIONS.SETTINGS_LAYOUT,
  PERMISSIONS.SETTINGS_GALLERY,
  PERMISSIONS.SETTINGS_SMTP,
];
const canSeeAnySettings = isSuper || settingsPerms.some((p) => hasPermission(perm, p));
const canSeeVideos = (features.heroVideos && (isSuper || hasPermission(perm, PERMISSIONS.VIDEOS_CAROUSEL))) || (features.videoLinks && (isSuper || hasPermission(perm, PERMISSIONS.VIDEOS_LINKS)));
const canSeeSellInquiries = features.sellInquiry && (isSuper || hasPermission(perm, PERMISSIONS.SELL_INQUIRIES));
const canSeeSmtp = features.sellInquiry && (isSuper || hasPermission(perm, PERMISSIONS.SETTINGS_SMTP));
const canSeeAnalytics = hasFeature(settings.featureLicenseMask ?? 0, FEATURE_ANALYTICS) && (isSuper || hasPermission(perm, PERMISSIONS.ANALYTICS));
---

<!doctype html>
<html lang="zh-Hant" class={activeStyle.className} style={styleVars(settings.activeStyle)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {settings.siteIconUrl ? <link rel="icon" href={siteIconUrl} /> : <link rel="icon" type="image/svg+xml" href={siteIconUrl} />}
    {settings.siteIconUrl && <link rel="apple-touch-icon" href={siteIconUrl} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body">

    <!-- Mobile header -->
    <header class="admin-header">
      <button class="admin-header__hamburger" id="admin-hamburger" aria-label="開啟選單" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <span class="admin-header__title">{settings.siteName || '後台管理'}</span>
      {isSuper && <span class="admin-header__user">{user.username}</span>}
    </header>

    <!-- Sidebar overlay (mobile) -->
    <div class="admin-overlay" id="admin-overlay" aria-hidden="true"></div>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="後台導覽">
      <div class="admin-sidebar__top">
        <a href="/admin" class="admin-logo">{settings.siteName || '後台管理'}</a>
        <button class="admin-sidebar__close" id="admin-sidebar-close" aria-label="關閉選單">✕</button>
      </div>

      <nav class="admin-sidebar__nav">
        <a href="/admin" class:list={['nav-item', { 'is-active': isActive('/admin') && !isActive('/admin/vehicles') && !isActive('/admin/brands') && !isActive('/admin/videos') && !isActive('/admin/sell-inquiries') && !isActive('/admin/settings') && !isActive('/admin/users') && !isActive('/admin/account') && !isActive('/admin/analytics') }]}>
          <span>概覽</span>
        </a>

        {(isSuper || hasPermission(perm, PERMISSIONS.VEHICLES_VIEW)) && (
          <a href="/admin/vehicles" class:list={['nav-item', { 'is-active': isActive('/admin/vehicles') }]}>
            <span>車輛管理</span>
          </a>
        )}

        {(isSuper || hasPermission(perm, PERMISSIONS.BRANDS_VIEW)) && (
          <a href="/admin/brands" class:list={['nav-item', { 'is-active': isActive('/admin/brands') }]}>
            <span>品牌管理</span>
          </a>
        )}

        {canSeeVideos && (
          <a href="/admin/videos" class:list={['nav-item', { 'is-active': isActive('/admin/videos') }]}>
            <span>影片管理</span>
          </a>
        )}

        {canSeeSellInquiries && (
          <a href="/admin/sell-inquiries" class:list={['nav-item', { 'is-active': isActive('/admin/sell-inquiries') }]}>
            <span>賣車申請</span>
          </a>
        )}

        {canSeeAnySettings && (
          <div class="nav-group">
            <span class="nav-group__label">設定</span>
            {(isSuper || hasPermission(perm, PERMISSIONS.SETTINGS_BASIC)) && (
              <a href="/admin/settings/basic" class:list={['nav-item nav-item--sub', { 'is-active': isActive('/admin/settings/basic') }]}>基本資訊</a>
            )}
            {(isSuper || hasPermission(perm, PERMISSIONS.SETTINGS_LAYOUT)) && (
              <a href="/admin/settings/layout" class:list={['nav-item nav-item--sub', { 'is-active': isActive('/admin/settings/layout') }]}>版型設定</a>
            )}
            {(isSuper || hasPermission(perm, PERMISSIONS.SETTINGS_GALLERY)) && (
              <a href="/admin/settings/gallery" class:list={['nav-item nav-item--sub', { 'is-active': isActive('/admin/settings/gallery') }]}>照片模式</a>
            )}
            {canSeeSmtp && (
              <a href="/admin/settings/smtp" class:list={['nav-item nav-item--sub', { 'is-active': isActive('/admin/settings/smtp') }]}>SMTP 通知</a>
            )}
            {isSuper && (
              <a href="/admin/settings/features" class:list={['nav-item nav-item--sub', { 'is-active': isActive('/admin/settings/features') }]}>授權管理</a>
            )}
          </div>
        )}

        {canSeeAnalytics && (
          <a href="/admin/analytics" class:list={['nav-item', { 'is-active': isActive('/admin/analytics') }]}>
            <span>流量分析</span>
          </a>
        )}

        {(isSuper || hasPermission(perm, PERMISSIONS.USERS_MANAGE)) && (
          <a href="/admin/users" class:list={['nav-item', { 'is-active': isActive('/admin/users') }]}>
            <span>用戶管理</span>
          </a>
        )}
      </nav>

      <div class="admin-sidebar__footer">
        <a href="/admin/account" class:list={['nav-item', { 'is-active': isActive('/admin/account') }]}>帳號設定</a>
        <a href="/" target="_blank" rel="noopener" class="nav-item nav-item--external">查看網站 ↗</a>
        <form method="post" action="/api/admin/logout">
          <button type="submit" class="admin-sidebar__logout">登出</button>
        </form>
      </div>
    </aside>

    <main class="admin-main">
      <slot />
    </main>

    <script>
      const hamburger = document.getElementById('admin-hamburger');
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('admin-overlay');
      const closeBtn = document.getElementById('admin-sidebar-close');

      function openSidebar() {
        sidebar?.classList.add('is-open');
        overlay?.classList.add('is-visible');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebar?.classList.remove('is-open');
        overlay?.classList.remove('is-visible');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
      hamburger?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      overlay?.addEventListener('click', closeSidebar);
    </script>
  </body>
</html>

<style is:global>
.admin-body { margin: 0; font-family: 'Outfit', 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', system-ui, sans-serif; background: var(--bg); color: var(--text); }

/* ── Mobile header ── */
.admin-header {
  display: none; position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  height: 52px; padding: 0 1rem;
  background: color-mix(in srgb, var(--surface) 96%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  color: var(--text);
  align-items: center; justify-content: space-between;
}
.admin-header__hamburger { display: flex; flex-direction: column; gap: 5px; background: none; border: 0; padding: 5px; cursor: pointer; border-radius: 6px; }
.admin-header__hamburger span { display: block; width: 20px; height: 1.5px; background: var(--text); border-radius: 2px; transition: all 0.2s; }
.admin-header__title { font-weight: 700; font-size: 0.9rem; letter-spacing: 0.03em; }
.admin-header__user { font-size: 0.78rem; color: var(--muted); }

/* ── Sidebar ── */
.admin-sidebar {
  position: fixed; left: 0; top: 0; bottom: 0;
  width: 15.5rem; z-index: 100;
  background: var(--surface);
  border-right: 1px solid var(--line);
  color: var(--text);
  display: flex; flex-direction: column;
  overflow-y: auto;
}
.admin-sidebar__top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.35rem 1.15rem 1rem;
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}
.admin-logo {
  color: var(--accent-strong); text-decoration: none;
  font-weight: 900; font-size: 0.76rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  display: flex; align-items: center; gap: 0.6rem;
}
.admin-logo::before {
  content: ''; display: block;
  width: 8px; height: 8px; border-radius: 2px;
  background: var(--accent); flex-shrink: 0;
}
.admin-sidebar__close {
  display: none; background: none; border: 0;
  color: var(--muted); font-size: 1rem; cursor: pointer;
  padding: 3px 7px; border-radius: 6px;
  transition: color 0.12s, background 0.12s;
}
.admin-sidebar__close:hover { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }

.admin-sidebar__nav { flex: 1; padding: 0.7rem 0.6rem; display: flex; flex-direction: column; gap: 1px; }
.nav-item {
  display: flex; align-items: center;
  padding: 0.5rem 0.85rem;
  color: var(--muted); text-decoration: none;
  font-size: 0.875rem; font-weight: 500;
  border-radius: 8px; position: relative;
  transition: background 0.12s, color 0.12s;
}
.nav-item:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--text); }
.nav-item.is-active {
  background: color-mix(in srgb, var(--accent) 13%, transparent);
  color: var(--accent-strong); font-weight: 700;
}
.nav-item.is-active::before {
  content: '';
  position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 3px; height: 56%; background: var(--accent); border-radius: 0 3px 3px 0;
}
.nav-item--sub { padding-left: 1.55rem; font-size: 0.82rem; }
.nav-item--external { font-size: 0.8rem; }

.nav-group { margin-top: 0.85rem; }
.nav-group__label {
  display: block; padding: 0.1rem 0.85rem 0.4rem;
  font-size: 0.64rem; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: color-mix(in srgb, var(--muted) 55%, transparent);
}

/* ── Sidebar footer ── */
.admin-sidebar__footer {
  padding: 0.6rem 0.6rem 0.85rem;
  border-top: 1px solid var(--line);
  display: flex; flex-direction: column; gap: 1px; flex-shrink: 0;
}
.admin-sidebar__logout {
  display: flex; align-items: center;
  padding: 0.5rem 0.85rem;
  background: none; border: 0;
  color: var(--muted); font-size: 0.875rem; font-weight: 500;
  cursor: pointer; width: 100%; text-align: left; border-radius: 8px;
  transition: background 0.12s, color 0.12s;
}
.admin-sidebar__logout:hover { background: color-mix(in srgb, #dc5a5a 9%, transparent); color: #e8a0a0; }

/* ── Overlay ── */
.admin-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; backdrop-filter: blur(4px); }
.admin-overlay.is-visible { display: block; }

/* ── Main content ── */
.admin-main { margin-left: 15.5rem; min-height: 100vh; padding: clamp(1.25rem, 3vw, 2.25rem); display: grid; gap: 1.5rem; align-content: start; }

/* ── Mobile ── */
@media (max-width: 768px) {
  .admin-header { display: flex; }
  .admin-main { margin-left: 0; padding: calc(52px + 1.25rem) 1rem 2rem; }
  .admin-sidebar { width: min(18rem, 86vw); transform: translateX(-100%); transition: transform 0.22s cubic-bezier(0.4,0,0.2,1); }
  .admin-sidebar.is-open { transform: translateX(0); }
  .admin-sidebar__close { display: block; }
}
</style>
