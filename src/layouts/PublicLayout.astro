---
import { getSettings } from '@/lib/settings';
import { styleVars, styles, templates } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getSettings();
const title = Astro.props.title || settings.siteName;
const description = Astro.props.description || '私人高級車顧問，嚴選高端中古車款。';
const template = templates[settings.activeTemplate];
const style = styles[settings.activeStyle];
const themeColor = settings.activeStyle === 'carsmeet-blue' ? '#2f66ad' : '#070605';
---

<!doctype html>
<html lang="zh-Hant" class={`${template.layoutClass} ${style.className}`} style={styleVars(settings.activeStyle)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand-mark" href="/">{settings.siteName}</a>
      <nav aria-label="主選單">
        <a href="/cars">車輛收藏</a>
        <a href="/about">關於</a>
        <a href="/contact">聯絡</a>
        <a href={settings.lineUrl}>LINE 洽詢</a>
        <a href={`tel:${settings.phoneNumber}`}>電話</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{settings.salespersonName}</strong>
        <span>公司地址：台北市信義區範例路 00 號 0 樓</span>
        <span>營業時間：週一至週六 10:00-19:00，採預約賞車</span>
      </div>
      <div class="footer-meta">
        <div class="social-icons" aria-label="社群連結">
          <a class="social-icon" href={settings.lineUrl} aria-label="LINE"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 18.5c-2-1.5-3-3.4-3-5.7 0-4.6 4.3-8.3 9.5-8.3s9.5 3.7 9.5 8.3-4.3 8.3-9.5 8.3c-.9 0-1.8-.1-2.6-.3L5.5 22v-3.5Z" /></svg></a>
          <a class="social-icon" href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 3.8h9A3.7 3.7 0 0 1 20.2 7.5v9a3.7 3.7 0 0 1-3.7 3.7h-9a3.7 3.7 0 0 1-3.7-3.7v-9a3.7 3.7 0 0 1 3.7-3.7Z" /><path d="M8.7 12a3.3 3.3 0 1 0 6.6 0 3.3 3.3 0 0 0-6.6 0Z" /><path d="M16.7 7.2h.1" /></svg></a>
          <a class="social-icon" href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.4h2.2V4.8H14c-2.8 0-4.4 1.7-4.4 4.5v2.1H7v3.7h2.6v5.1h4.1v-5.1h2.6l.5-3.7h-3.1V9.8c0-.9.3-1.4 1.3-1.4Z" /></svg></a>
          <a class="social-icon" href="#" aria-label="Threads"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.8 9.1c-.5-2.3-2.1-3.6-4.6-3.6-3.5 0-5.6 2.5-5.6 6.5 0 4.2 2.2 6.5 5.8 6.5 3 0 4.9-1.6 4.9-4 0-2-1.5-3.2-4.1-3.2-2 0-3.2.9-3.2 2.2 0 1.1.9 1.8 2.2 1.8 1.5 0 2.4-.8 2.4-2.2 0-.5-.1-.9-.3-1.2 2.3.3 3.8 1.3 4.5 3" /></svg></a>
          <a class="social-icon" href="#" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 4v10.5a4.4 4.4 0 1 1-4.4-4.4c.4 0 .8 0 1.1.1v3.6a1.4 1.4 0 1 0 1.4 1.4V4h1.9c.5 2.3 1.9 3.7 4.2 4.1v3.4c-1.6-.1-3-.7-4.2-1.8Z" /></svg></a>
        </div>
        <p>{settings.footerDisclaimer}</p>
      </div>
    </footer>
    <div class="share-toast" role="status" aria-live="polite">已複製車輛連結</div>
    <a class="back-to-top" href="#top" aria-label="回到最上方">↑</a>
    <div class="mobile-contact-bar" aria-label="快速聯絡">
      <a href={settings.lineUrl}>LINE 洽詢</a>
      <a href={`tel:${settings.phoneNumber}`}>立即來電</a>
    </div>
    <script>
      const backToTop = document.querySelector('.back-to-top');
      const mobileContactBar = document.querySelector('.mobile-contact-bar');
      const header = document.querySelector('.site-header');
      const updateBackToTop = () => {
        const isPastHeader = window.scrollY > (header?.clientHeight || 80);
        backToTop?.classList.toggle('is-visible', isPastHeader);
        mobileContactBar?.classList.toggle('is-visible', window.scrollY > 180);
      };
      updateBackToTop();
      window.addEventListener('scroll', updateBackToTop, { passive: true });

      const shareToast = document.querySelector('.share-toast');
      const showShareToast = () => {
        shareToast?.classList.add('is-visible');
        window.setTimeout(() => shareToast?.classList.remove('is-visible'), 1800);
      };
      document.addEventListener('click', async (event) => {
        const trigger = event.target instanceof Element ? event.target.closest('[data-share-url]') : null;
        if (!(trigger instanceof HTMLElement)) return;
        event.preventDefault();
        event.stopPropagation();
        const url = new URL(trigger.dataset.shareUrl || '/', window.location.origin).toString();
        const title = trigger.dataset.shareTitle || document.title;
        const text = trigger.dataset.shareText || '';
        try {
          if (navigator.share) {
            await navigator.share({ title, text, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          showShareToast();
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          await navigator.clipboard.writeText(url);
          showShareToast();
        }
      });
    </script>
  </body>
</html>
