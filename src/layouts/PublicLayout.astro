---
import SocialIcon from '@/components/SocialIcon.astro';
import { getSettings } from '@/lib/settings';
import { styleVars, styles, templates } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  shareText?: string;
  shareUrl?: string;
}

const settings = await getSettings();
const title = Astro.props.title || settings.siteName;
const description = Astro.props.description || '私人高級車顧問，嚴選高端中古車款。';
const pageShareText = Astro.props.shareText || description;
const pageShareUrl = Astro.props.shareUrl || Astro.url.pathname;
const template = templates[settings.activeTemplate];
const style = styles[settings.activeStyle];
const themeColor = settings.activeStyle === 'carsmeet-blue' ? '#2f66ad' : '#070605';
const socialLinks = [
  { platform: 'line', href: settings.lineUrl, label: 'LINE' },
  { platform: 'instagram', href: settings.instagramUrl, label: 'Instagram' },
  { platform: 'facebook', href: settings.facebookUrl, label: 'Facebook' },
  { platform: 'threads', href: settings.threadsUrl, label: 'Threads' },
  { platform: 'tiktok', href: settings.tiktokUrl, label: 'TikTok' },
].filter((item) => item.href && item.href !== '#') as { platform: 'line' | 'instagram' | 'facebook' | 'threads' | 'tiktok'; href: string; label: string }[];
---

<!doctype html>
<html lang="zh-Hant" class={`${template.layoutClass} ${style.className}`} style={styleVars(settings.activeStyle)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body id="top">
    <header class="site-header">
      <a class="brand-mark" href="/">{settings.siteName}</a>
      <nav aria-label="主選單">
        <a href="/cars">車輛收藏</a>
        <a href="/about">關於</a>
        <a href="/contact">聯絡</a>
        <a href={settings.lineUrl}>LINE 洽詢</a>
        <a href={`tel:${settings.phoneNumber}`}>電話</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{settings.salespersonName}</strong>
        <span>公司地址：台北市信義區範例路 00 號 0 樓</span>
        <span>營業時間：週一至週六 10:00-19:00，採預約賞車</span>
      </div>
      <div class="footer-meta">
        {socialLinks.length > 0 && (
          <div class="social-icons" aria-label="社群連結">
            {socialLinks.map((item) => <SocialIcon platform={item.platform} href={item.href} label={item.label} />)}
          </div>
        )}
        <p>{settings.footerDisclaimer}</p>
      </div>
    </footer>
    <div class="share-toast" role="status" aria-live="polite">已複製車輛連結</div>
    <a class="back-to-top" href="#top" aria-label="回到最上方">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" /></svg>
    </a>
    <div class="mobile-contact-bar" aria-label="快速聯絡">
      <button class="mobile-action mobile-action--share" type="button" data-share-title={title} data-share-text={pageShareText} data-share-url={pageShareUrl} aria-label="分享目前頁面">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.5 12.5 16 8M7.5 11.5 16 16M6.5 15.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM17.5 9.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM17.5 20.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" /></svg>
      </button>
      <a class="mobile-action mobile-action--line" href={settings.lineUrl} aria-label="LINE 洽詢">
        <svg class="brand-glyph" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 6C13.5 6 5 12.9 5 21.4c0 7.6 6.7 14 15.8 15.2.6.1 1.4.4 1.6.9.2.5.1 1.2.1 1.7l-.3 2c-.1.6-.5 2.3 1.7 1.3 2.2-1 11.7-6.9 16-11.8 3-3.3 4.1-6.4 4.1-9.3C43 12.9 34.5 6 24 6Z" /><path class="social-cutout" d="M13.4 26.2h6v-2.4h-3.3v-8.1h-2.7v10.5Zm7.2 0h2.7V15.7h-2.7v10.5Zm4.7 0H28v-6l4.8 6h2.4V15.7h-2.7v5.9l-4.7-5.9h-2.5v10.5Zm11.4 0h6.2v-2.3h-3.5v-1.8h3.1v-2.2h-3.1V18h3.5v-2.3h-6.2v10.5Z" /></svg>
      </a>
      <a class="mobile-action mobile-action--phone" href={`tel:${settings.phoneNumber}`} aria-label="立即來電">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.4 4.8 9.6 9c.3.6.2 1.3-.3 1.8l-1.1 1.1a12.3 12.3 0 0 0 4.9 4.9l1.1-1.1c.5-.5 1.2-.6 1.8-.3l4.2 2.2c.7.4 1 1.2.8 1.9-.4 1.5-1.7 2.5-3.2 2.5C9.1 22 2 14.9 2 6.2 2 4.7 3 3.4 4.5 3c.8-.2 1.6.1 1.9.8Z" /></svg>
      </a>
    </div>
    <script>
      const backToTop = document.querySelector('.back-to-top');
      const mobileContactBar = document.querySelector('.mobile-contact-bar');
      const header = document.querySelector('.site-header');
      const updateBackToTop = () => {
        const isPastHeader = window.scrollY > (header?.clientHeight || 80);
        backToTop?.classList.toggle('is-visible', isPastHeader);
        mobileContactBar?.classList.toggle('is-visible', window.scrollY > 180);
      };
      updateBackToTop();
      window.addEventListener('scroll', updateBackToTop, { passive: true });

      const shareToast = document.querySelector('.share-toast');
      const showShareToast = () => {
        shareToast?.classList.add('is-visible');
        window.setTimeout(() => shareToast?.classList.remove('is-visible'), 1800);
      };
      document.addEventListener('click', async (event) => {
        const trigger = event.target instanceof Element ? event.target.closest('[data-share-url]') : null;
        if (!(trigger instanceof HTMLElement)) return;
        event.preventDefault();
        event.stopPropagation();
        const url = new URL(trigger.dataset.shareUrl || '/', window.location.origin).toString();
        const text = trigger.dataset.shareText || '';
        const message = text.includes(url) ? text : [text, url].filter(Boolean).join('\n');
        try {
          if (navigator.share) {
            await navigator.share({ text: message });
            return;
          }
          await navigator.clipboard.writeText(message);
          showShareToast();
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          await navigator.clipboard.writeText(message);
          showShareToast();
        }
      });
    </script>
  </body>
</html>
