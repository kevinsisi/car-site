---
import SocialIcon from '@/components/SocialIcon.astro';
import PremiumIcon from '@/components/PremiumIcon.astro';
import CompareBar from '@/components/CompareBar.astro';
import VideoCarousel from '@/components/VideoCarousel.astro';
import ChatWidget from '@/components/ChatWidget.svelte';
import { getSettings } from '@/lib/settings';
import type { SiteSettings } from '@/lib/settings';
import { createD1Db } from '@/db/d1';
import { getPublicNavItems, resolveFrontFeatures } from '@/lib/front-features';
import { siteIconHref } from '@/lib/site-icon';
import { styleVars, styles, templates } from '@/lib/theme';
import { shareOriginFromRequest } from '@/lib/vehicle-share';
import { shouldHidePublicAiChat } from '@/lib/production-feature-policy';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  shareText?: string;
  shareUrl?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  showMobileActions?: boolean;
  showBackToTop?: boolean;
  settings?: SiteSettings;
}

const runtime = Astro.locals.runtime;
const binding = runtime?.env?.DB_PREVIEW;
if (runtime && !binding) return new Response('Preview database unavailable', { status: 503 });
const adapter = binding ? await createD1Db(binding) : undefined;
const settings = Astro.props?.settings ?? await getSettings(adapter);
const features = resolveFrontFeatures(settings);
const hidePublicAiChat = shouldHidePublicAiChat(runtime);
const title = Astro.props.title || settings.siteName;
const description = Astro.props.description || '私人高級車顧問，嚴選高端中古車款。';
const pageShareText = Astro.props.shareText || description;
const pageShareUrl = Astro.props.shareUrl || Astro.url.pathname;
const publicOrigin = shareOriginFromRequest(Astro.request, Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, publicOrigin).toString();
const absoluteOgImage = Astro.props.ogImage
  ? new URL(Astro.props.ogImage, publicOrigin).toString()
  : '';
const siteIconUrl = siteIconHref(settings);
const ogType = Astro.props.ogType || 'website';
const jsonLdArray = Array.isArray(Astro.props.jsonLd)
  ? Astro.props.jsonLd
  : Astro.props.jsonLd
    ? [Astro.props.jsonLd]
    : [];
const showMobileActions = Astro.props.showMobileActions ?? true;
const showBackToTop = Astro.props.showBackToTop ?? true;
const template = templates[settings.activeTemplate];
const style = styles[settings.activeStyle];
const themeColors: Record<typeof settings.activeStyle, string> = {
  'carsmeet-blue': '#2f66ad',
  'champagne-black': '#070605',
  'warm-gallery': '#f4efe6',
  'executive-slate': '#10151a',
  'classic-burgundy': '#120609',
};
const themeColor = themeColors[settings.activeStyle] || '#070605';
const pathname = Astro.url.pathname;
const showHeaderVideo = pathname === '/' && features.heroVideos && settings.videoSectionPosition === 'above-header' && settings.heroVideos.length > 0;
const isCurrentPath = (test: string) => {
  if (test === '/') return pathname === '/';
  if (test === '/cars') return pathname === '/cars' || pathname.startsWith('/cars/');
  return pathname === test;
};
const copyrightYear = new Date().getFullYear();
const socialLinks = [
  ...(features.directContact ? [{ platform: 'line' as const, href: settings.lineUrl, label: 'LINE' }] : []),
  ...(features.socialIcons ? [
    { platform: 'instagram' as const, href: settings.instagramUrl, label: 'Instagram' },
    { platform: 'facebook' as const, href: settings.facebookUrl, label: 'Facebook' },
    { platform: 'threads' as const, href: settings.threadsUrl, label: 'Threads' },
    { platform: 'tiktok' as const, href: settings.tiktokUrl, label: 'TikTok' },
  ] : []),
].filter((item) => item.href && item.href !== '#') as { platform: 'line' | 'instagram' | 'facebook' | 'threads' | 'tiktok'; href: string; label: string }[];
const socialIcons = settings.socialIcons || {};
const mapQuery = settings.storeAddress ? encodeURIComponent(settings.storeAddress) : '';
const mapHref = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${mapQuery}` : '';
const navItems = getPublicNavItems(features);
---

<!doctype html>
<html lang="zh-Hant" class={`${template.layoutClass} ${style.className}`} style={styleVars(settings.activeStyle)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    {settings.siteIconUrl ? <link rel="icon" href={siteIconUrl} /> : <link rel="icon" type="image/svg+xml" href={siteIconUrl} />}
    {settings.siteIconUrl && <link rel="apple-touch-icon" href={siteIconUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={settings.siteName} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {jsonLdArray.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-to-content" href="#main">跳至主要內容</a>
    {showHeaderVideo && <VideoCarousel videos={settings.heroVideos} variant="top-strip" />}
    <header class="site-header">
      <a class="brand-mark" href="/" aria-current={pathname === '/' ? 'page' : undefined}>{settings.siteName}</a>
      <button class="site-menu-toggle" type="button" aria-label="開啟主選單" aria-expanded="false" aria-controls="site-nav">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="主選單">
        {navItems.map((item) => <a href={item.href} aria-current={isCurrentPath(item.activeMatch) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="site-cta">
        {mapHref && (
          <a class="site-address" href={mapHref} target="_blank" rel="noopener noreferrer" aria-label={`查看地址：${settings.storeAddress}`}>
            <span class="site-address__label">地址</span>
            <span class="site-address__text">{settings.storeAddress}</span>
          </a>
        )}
        {features.directContact && settings.lineUrl && settings.lineUrl !== '#' && (
          <a class="site-cta__link site-cta__link--line" href={settings.lineUrl}>
            <PremiumIcon platform="line" label="LINE" customIcon={socialIcons.line} />
            <span>LINE 洽詢</span>
          </a>
        )}
        {features.directContact && settings.phoneNumber && (
          <a class="site-cta__link site-cta__link--phone" href={`tel:${settings.phoneNumber}`} aria-label="電話聯絡">
            <PremiumIcon platform="phone" label="電話" customIcon={socialIcons.phone} />
            <span>電話</span>
          </a>
        )}
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {features.compare && <CompareBar />}
    <footer class="site-footer">
      <div class="site-footer__col site-footer__col--info">
        <strong>{settings.salespersonName}</strong>
        {settings.storeAddress && <span>地址：{settings.storeAddress}</span>}
        {settings.businessHours && <span>營業時間：{settings.businessHours}</span>}
        <nav class="footer-links" aria-label="頁尾選單">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
      <div class="footer-meta">
        {socialLinks.length > 0 && (
          <div class="social-icons" aria-label="社群連結">
            {socialLinks.map((item) => <SocialIcon platform={item.platform} href={item.href} label={item.label} customIcon={socialIcons[item.platform]} />)}
          </div>
        )}
        <p>{settings.footerDisclaimer}</p>
        <small class="copyright">© {copyrightYear} {settings.siteName}．All rights reserved.</small>
      </div>
    </footer>
    <div class="share-toast" role="status" aria-live="polite">已複製車輛連結</div>
    {showBackToTop && (
      <a class="back-to-top" href="#top" aria-label="回到最上方">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" /></svg>
      </a>
    )}
    {showMobileActions && features.directContact && (
      <div class="mobile-contact-bar" aria-label="快速聯絡">
        <button class="mobile-action mobile-action--share" type="button" data-share-title={title} data-share-text={pageShareText} data-share-url={pageShareUrl} aria-label="分享目前頁面">
          <PremiumIcon platform="share" label="分享" customIcon={socialIcons.share} />
        </button>
        <a class="mobile-action mobile-action--line" href={settings.lineUrl} aria-label="LINE 洽詢">
          <PremiumIcon platform="line" label="LINE" customIcon={socialIcons.line} />
        </a>
        <a class="mobile-action mobile-action--phone" href={`tel:${settings.phoneNumber}`} aria-label="立即來電">
          <PremiumIcon platform="phone" label="電話" customIcon={socialIcons.phone} />
        </a>
      </div>
    )}
    <script>
      const backToTop = document.querySelector('.back-to-top');
      const mobileContactBar = document.querySelector('.mobile-contact-bar');
      const header = document.querySelector('.site-header');
      const menuToggle = document.querySelector<HTMLButtonElement>('.site-menu-toggle');
      const siteNav = document.querySelector<HTMLElement>('.site-nav');
      const closeSiteNav = () => {
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', '開啟主選單');
        siteNav?.classList.remove('is-open');
      };
      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') !== 'true';
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? '關閉主選單' : '開啟主選單');
        siteNav?.classList.toggle('is-open', open);
      });
      siteNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeSiteNav));
      window.matchMedia('(min-width: 901px)').addEventListener('change', closeSiteNav);
      let lastScrollY = window.scrollY;
      const updateBackToTop = () => {
        const currentScrollY = window.scrollY;
        const isPastHeader = currentScrollY > (header?.clientHeight || 80);
        const isScrollingDown = currentScrollY > lastScrollY + 24;
        const isScrollingUp = currentScrollY < lastScrollY - 12;
        backToTop?.classList.toggle('is-visible', isPastHeader);
        mobileContactBar?.classList.toggle('is-visible', currentScrollY > 180);
        if (isScrollingDown && currentScrollY > 240) header?.classList.add('is-hidden');
        if (isScrollingUp || currentScrollY < 40) header?.classList.remove('is-hidden');
        if (isScrollingDown || isScrollingUp) lastScrollY = currentScrollY;
      };
      updateBackToTop();
      window.addEventListener('scroll', updateBackToTop, { passive: true });

      document.addEventListener('error', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLImageElement)) return;
        if (target.dataset.imgErrorHandled) return;
        target.dataset.imgErrorHandled = '1';
        target.removeAttribute('srcset');
        target.removeAttribute('src');
        target.classList.add('image-error');
        if (!target.alt) target.alt = '圖片載入失敗';
      }, { capture: true });

      const prefetchedLinks = new Set();
      const prefetchPage = (href: string) => {
        if (!href || prefetchedLinks.has(href)) return;
        prefetchedLinks.add(href);
        const link = document.createElement('link');
        link.rel = 'prefetch';
        link.href = href;
        document.head.appendChild(link);
      };
      document.addEventListener('pointerover', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="/cars/"]') : null;
        if (link instanceof HTMLAnchorElement) prefetchPage(link.href);
      }, { passive: true });
      document.addEventListener('touchstart', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href^="/cars/"]') : null;
        if (link instanceof HTMLAnchorElement) prefetchPage(link.href);
      }, { passive: true });

      const shareToast = document.querySelector('.share-toast');
      const showShareToast = () => {
        shareToast?.classList.add('is-visible');
        window.setTimeout(() => shareToast?.classList.remove('is-visible'), 1800);
      };
      document.addEventListener('click', async (event) => {
        const trigger = event.target instanceof Element ? event.target.closest('[data-share-url]') : null;
        if (!(trigger instanceof HTMLElement)) return;
        event.preventDefault();
        event.stopPropagation();
        const url = new URL(trigger.dataset.shareUrl || '/', window.location.origin).toString();
        const text = trigger.dataset.shareText || '';
        const message = text.includes(url) ? text : [text, url].filter(Boolean).join('\n');
        try {
          if (navigator.share) {
            await navigator.share({ text: message });
            return;
          }
          await navigator.clipboard.writeText(message);
          showShareToast();
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          await navigator.clipboard.writeText(message);
          showShareToast();
        }
      });
    </script>
    {features.aiChatbot && !hidePublicAiChat && (
      <ChatWidget client:load openingMessage={settings.aiChatOpening} />
    )}
  </body>
</html>
