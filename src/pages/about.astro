---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getSettings } from '@/lib/settings';
import { getFirstPublicHref, resolveFrontFeatures } from '@/lib/front-features';
import { createD1Db } from '@/db/d1';

const runtime = Astro.locals.runtime;
const binding = runtime?.env?.DB_PREVIEW;
if (runtime && !binding) return new Response('Preview database unavailable', { status: 503 });
const adapter = binding ? await createD1Db(binding) : undefined;
const settings = await getSettings(adapter);
const features = resolveFrontFeatures(settings);
const fallbackHref = getFirstPublicHref(features);
if (!features.aboutPage) return Astro.redirect(fallbackHref);
const promises = [
  {
    title: '車況先行',
    body: '交付前以外觀、內裝、儀表與基本機件狀態為核心，先確認風險，再安排賞車。',
    icon: 'shield',
  },
  {
    title: '精準媒合',
    body: '不追求大量刊登，只協助客戶縮短篩選時間，找到值得親自看的車。',
    icon: 'target',
  },
  {
    title: '交易陪同',
    body: '從初談、預約賞車到後續交付，以顧問式流程降低資訊落差。',
    icon: 'people',
  },
  {
    title: '保修銜接',
    body: '可協助安排後續保養、檢查與交車前整備建議，讓高級車使用更安心。',
    icon: 'wrench',
  },
];
---

<PublicLayout title={`關於｜${settings.siteName}`} description="私人高級車顧問服務介紹。">
  <section class="page-hero compact luxury-enter">
    <p class="eyebrow">關於我們</p>
    <h1>不是車海平台，是為成熟買家整理的私人車庫。</h1>
    <p>我們重視車況、來源、配置與時間效率。每一次推薦，都以是否值得親自介紹作為標準。</p>
  </section>
  <section class="promise-grid reveal-section">
    {promises.map(({ title, body, icon }) => (
      <article>
        <span class="promise-icon" aria-hidden="true">
          {icon === 'shield' && (
            <svg viewBox="0 0 24 24"><path d="M12 3.5 19 7v5.1c0 4.3-2.8 7.5-7 8.4-4.2-.9-7-4.1-7-8.4V7l7-3.5Z" /><path d="m8.7 12.1 2.1 2.1 4.7-5" /></svg>
          )}
          {icon === 'target' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1.5" /></svg>
          )}
          {icon === 'people' && (
            <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9.5" r="2.3" /><path d="M3.5 20c.4-3.2 2.7-5 5.5-5s5.1 1.8 5.5 5" /><path d="M14 20c.3-2.6 1.8-4 3.5-4s3.2 1.4 3.5 4" /></svg>
          )}
          {icon === 'wrench' && (
            <svg viewBox="0 0 24 24"><path d="M14.7 6.3a3 3 0 0 1 4 4l-3 .8-1.8-1.8.8-3z" /><path d="M14.5 10.2 4.3 20.4a2 2 0 0 1-2.8-2.8L11.7 7.4" /></svg>
          )}
        </span>
        <h2>{title}</h2>
        <p>{body}</p>
      </article>
    ))}
  </section>
  {features.directContact && settings.lineUrl && settings.lineUrl !== '#' && (
    <section class="contact-strip reveal-section">
      <div>
        <p class="eyebrow">私人預約</p>
        <h2>預約賞車前，先用 LINE 說明需求。</h2>
      </div>
      <a class="button button--primary" href={settings.lineUrl}>LINE 洽詢</a>
    </section>
  )}
</PublicLayout>
