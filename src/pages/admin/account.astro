---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { asc } from 'drizzle-orm';
import { adminUsers } from '@/db/schema';
import { getSession, hasAnyUsers } from '@/lib/auth';
import { createD1Db } from '@/db/d1';

const runtime = Astro.locals.runtime;
const binding = runtime?.env?.DB_PREVIEW;
const sessionSecret = runtime?.env?.SESSION_SECRET;
if (runtime && (!binding || !sessionSecret)) return new Response('Preview database unavailable', { status: 503 });
const adapter = binding ? await createD1Db(binding) : undefined;
const authOptions = { db: adapter, sessionSecret };
if (!await hasAnyUsers(authOptions)) return Astro.redirect('/admin/setup');
const user = await getSession(Astro.cookies, authOptions);
if (!user) return Astro.redirect('/admin/login');
const isForced = Astro.url.searchParams.get('force') === '1';
const isSuper = user.role === 'superadmin';
let accounts: { id: string; username: string; createdAt: string }[] = [];
if (isSuper) {
  if (adapter) {
    accounts = await adapter
      .select({ id: adminUsers.id, username: adminUsers.username, createdAt: adminUsers.createdAt })
      .from(adminUsers)
      .orderBy(asc(adminUsers.createdAt), asc(adminUsers.id))
      .limit(100);
  } else {
    const { db } = await import('@/db/connection');
    accounts = await db
      .select({ id: adminUsers.id, username: adminUsers.username, createdAt: adminUsers.createdAt })
      .from(adminUsers)
      .orderBy(asc(adminUsers.createdAt));
  }
}
---

<AdminLayout user={user}>
  <section class="admin-panel hero-panel">
    <div>
      <p class="admin-eyebrow">帳號設定</p>
      <h1>帳號設定</h1>
      <p>變更自己的密碼，並管理可登入後台的管理員帳號。</p>
    </div>
    <span class="account-current">目前帳號：<strong>{user.username}</strong></span>
  </section>

  {isForced && (
    <div class="admin-panel force-banner" role="alert">
      <strong>請先變更預設密碼</strong>
      <p>目前仍在使用部署時的預設密碼 <code>change-me-now</code>，必須先設定新密碼才能繼續使用後台。</p>
    </div>
  )}

  <section class="admin-panel">
    <h2>變更自己的密碼</h2>
    <form id="change-password-form" class="settings-form" autocomplete="off">
      <label>目前密碼 <input name="currentPassword" type="password" autocomplete="current-password" required minlength="4" /></label>
      <label>新密碼 <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" /></label>
      <label>新密碼再次確認 <input name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" /></label>
      <p class="form-hint">新密碼至少 8 個字元。建議混用英文字母、數字、符號。</p>
      <button class="admin-button" type="submit">儲存新密碼</button>
    </form>
  </section>

  {isSuper && (
    <section class="admin-panel">
      <div class="hero-panel">
        <div>
          <h2>管理員帳號</h2>
          <p>所有可登入後台的帳號。至少保留一個帳號；無法刪除目前登入中的帳號。</p>
        </div>
        <span class="account-current">總共 <strong id="account-count">{accounts.length}</strong> 個</span>
      </div>

      <ul class="account-list" id="account-list">
        {accounts.map((acc) => (
          <li class="account-item" data-id={acc.id}>
            <div>
              <strong>{acc.username}</strong>
              {acc.id === user.id && <span class="account-badge">目前登入</span>}
              <small>建立於 {new Date(acc.createdAt).toLocaleDateString('zh-TW')}</small>
            </div>
            {acc.id !== user.id && (
              <button type="button" class="row-button--danger account-delete" data-id={acc.id} data-username={acc.username}>刪除帳號</button>
            )}
          </li>
        ))}
      </ul>

      <h3>新增管理員</h3>
      <form id="new-account-form" class="settings-form" autocomplete="off">
        <label>帳號 <input name="username" required minlength="3" placeholder="英文字母、數字、底線、點、短橫線" /></label>
        <label>密碼 <input name="password" type="password" autocomplete="new-password" required minlength="8" /></label>
        <p class="form-hint">建立後，新帳號就能用上述帳密登入後台。</p>
        <button class="admin-button" type="submit">建立帳號</button>
      </form>
    </section>
  )}

  <div id="account-toast-root"></div>

  <script>
    const passForm = document.getElementById('change-password-form') as HTMLFormElement | null;
    const newAccountForm = document.getElementById('new-account-form') as HTMLFormElement | null;
    const accountList = document.getElementById('account-list');
    const accountCount = document.getElementById('account-count');
    const toastRoot = document.getElementById('account-toast-root');

    function showToast(text: string, level: 'success' | 'error' = 'success') {
      if (!toastRoot) return;
      const stack = toastRoot.querySelector('.toast-stack') || (() => {
        const el = document.createElement('div');
        el.className = 'toast-stack';
        el.setAttribute('role', 'status');
        el.setAttribute('aria-live', 'polite');
        toastRoot.appendChild(el);
        return el;
      })();
      const t = document.createElement('div');
      t.className = `toast toast--${level}`;
      t.innerHTML = `<span class="toast__text"></span><button class="toast__close" aria-label="關閉訊息">×</button>`;
      (t.querySelector('.toast__text') as HTMLElement).textContent = text;
      stack.appendChild(t);
      const close = () => t.remove();
      (t.querySelector('.toast__close') as HTMLElement).addEventListener('click', close);
      window.setTimeout(close, level === 'error' ? 6000 : 3000);
    }

    async function jsonFetch(input: string, init?: RequestInit) {
      const response = await fetch(input, init);
      if (response.status === 401) {
        window.location.href = '/admin/login?expired=1';
        throw new Error('expired');
      }
      return response;
    }

    passForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(passForm);
      const currentPassword = String(formData.get('currentPassword') || '');
      const newPassword = String(formData.get('newPassword') || '');
      const confirmPassword = String(formData.get('confirmPassword') || '');
      if (newPassword !== confirmPassword) {
        showToast('新密碼兩次輸入不一致', 'error');
        return;
      }
      const response = await jsonFetch('/api/admin/change-password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      const result = await response.json().catch(() => ({}));
      if (response.ok) {
        showToast('密碼已更新');
        passForm.reset();
      } else {
        showToast(result.error || '密碼更新失敗', 'error');
      }
    });

    newAccountForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(newAccountForm);
      const username = String(formData.get('username') || '').trim();
      const password = String(formData.get('password') || '');
      const response = await jsonFetch('/api/admin/accounts', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const result = await response.json().catch(() => ({}));
      if (response.ok) {
        showToast(`已建立帳號「${username}」`);
        newAccountForm.reset();
        window.setTimeout(() => window.location.reload(), 700);
      } else {
        showToast(result.error || '帳號建立失敗', 'error');
      }
    });

    accountList?.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement)?.closest('.account-delete') as HTMLElement | null;
      if (!btn) return;
      const id = btn.dataset.id;
      const username = btn.dataset.username;
      if (!id) return;
      const ok = window.confirm(`確定要刪除帳號「${username}」嗎？刪除後該帳號將無法再登入後台，且操作無法復原。`);
      if (!ok) return;
      const response = await jsonFetch(`/api/admin/accounts/${id}`, { method: 'DELETE' });
      const result = await response.json().catch(() => ({}));
      if (response.ok) {
        showToast(`已刪除帳號「${username}」`);
        const item = accountList.querySelector(`[data-id="${id}"]`);
        item?.remove();
        if (accountCount) accountCount.textContent = String(accountList.querySelectorAll('.account-item').length);
      } else {
        showToast(result.error || '刪除失敗', 'error');
      }
    });
  </script>
</AdminLayout>

<style>
  .account-current { color: var(--muted); font-size: 0.92rem; }
  .account-current strong { color: var(--accent-strong); }
  .force-banner { border-color: color-mix(in srgb, var(--accent) 48%, var(--line)); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .force-banner strong { color: var(--accent-strong); font-size: 1.05rem; display: block; margin-bottom: 0.4rem; }
  .force-banner code { padding: 0.1rem 0.35rem; background: color-mix(in srgb, var(--surface) 82%, transparent); border-radius: 0.25rem; font-size: 0.9em; }
  .account-list { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.5rem; }
  .account-item { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.05rem; border: 1px solid var(--line); border-radius: 0.85rem; background: color-mix(in srgb, var(--bg) 80%, var(--surface)); }
  .account-item > div { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
  .account-item strong { color: var(--text); font-size: 1.05rem; }
  .account-item small { display: block; flex-basis: 100%; color: color-mix(in srgb, var(--muted) 70%, transparent); font-size: 0.78rem; margin-top: 0.18rem; }
  .account-badge { padding: 0.18rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent-strong); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; }
  .account-delete { min-height: 2.2rem; padding: 0 0.85rem; border-radius: 999px; cursor: pointer; }
</style>
