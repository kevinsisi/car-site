---
import AdminDashboard from '@/components/AdminDashboard.svelte';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSession, hasAnyUsers } from '@/lib/auth';
import { listBrandAliases } from '@/lib/brand-aliases';
import { getSettings } from '@/lib/settings';
import { countUnreadSellInquiries } from '@/lib/sell-inquiries';
import { listAdminVehicles } from '@/lib/vehicles';

if (!await hasAnyUsers()) return Astro.redirect('/admin/setup');
const user = await getSession(Astro.cookies);
if (!user) return Astro.redirect('/admin/login');

const vehicles = await listAdminVehicles();
const settings = await getSettings();
const brandAliases = await listBrandAliases();
const unreadSellCount = await countUnreadSellInquiries();
---

<AdminLayout user={user}>
  <AdminDashboard client:load mode="overview" vehicles={vehicles} settings={settings} brandAliases={brandAliases} />
  {unreadSellCount > 0 && (
    <div class="unread-banner">
      <a href="/admin/sell-inquiries">
        📬 有 {unreadSellCount} 筆新賣車申請待查看
      </a>
    </div>
  )}
</AdminLayout>

<style>
.unread-banner {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  background: var(--accent);
  color: var(--bg);
  padding: 0.75rem 1.25rem;
  border-radius: 8px;
  box-shadow: 0 4px 12px color-mix(in srgb, var(--text) 18%, transparent);
  font-size: 0.9rem;
  z-index: 50;
}
.unread-banner a {
  color: var(--bg);
  text-decoration: none;
  font-weight: 600;
}
</style>
