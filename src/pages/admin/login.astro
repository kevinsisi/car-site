---
import '@/styles/admin.css';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>登入管理後台</title>
  </head>
  <body class="login-body">
    <form class="login-card" method="post" action="/api/admin/login">
      <p class="admin-eyebrow">Private Motor Salon</p>
      <h1>管理後台登入</h1>
      <label>帳號 <input name="username" autocomplete="username" required /></label>
      <label>密碼 <input name="password" type="password" autocomplete="current-password" required /></label>
      <button class="admin-button" type="submit">登入</button>
    </form>
  </body>
</html>
