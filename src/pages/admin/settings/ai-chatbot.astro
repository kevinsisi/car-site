---
import AdminLayout from '@/layouts/AdminLayout.astro';
import SettingsAiChatbot from '@/components/admin/SettingsAiChatbot.svelte';
import { getSession, hasAnyUsers } from '@/lib/auth';
import { getSettings } from '@/lib/settings';
import { hasFeature, FEATURE_AI_CHATBOT } from '@/lib/features';
import { PERMISSIONS, hasPermission } from '@/lib/permissions';
import { getOpenCodeStatus } from '@/lib/opencode-settings';

if (!await hasAnyUsers()) return Astro.redirect('/admin/setup');
const user = await getSession(Astro.cookies);
if (!user) return Astro.redirect('/admin/login');

const isSuper = user.role === 'superadmin';
const canAccess = isSuper || hasPermission(user.permissions, PERMISSIONS.SETTINGS_AI_CHATBOT);
if (!canAccess) return Astro.redirect('/admin');

const settings = await getSettings();
if (!hasFeature(settings.featureLicenseMask, FEATURE_AI_CHATBOT)) return Astro.redirect('/admin/settings/features');

const openCodeStatus = isSuper ? await getOpenCodeStatus() : null;
---
<AdminLayout user={user} title="AI 客服設定">
  <SettingsAiChatbot
    client:load
    settings={settings}
    isSuper={isSuper}
    openCodeStatus={openCodeStatus}
  />
</AdminLayout>
