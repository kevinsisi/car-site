---
import AdminLayout from '@/layouts/AdminLayout.astro';
import SettingsGallery from '@/components/admin/SettingsGallery.svelte';
import { getSession, hasAnyUsers } from '@/lib/auth';
import { PERMISSIONS, hasPermission } from '@/lib/permissions';
import { getSettings } from '@/lib/settings';

if (!await hasAnyUsers()) return Astro.redirect('/admin/setup');
const user = await getSession(Astro.cookies);
if (!user) return Astro.redirect('/admin/login');
if (user.role !== 'superadmin' && !hasPermission(user.permissions, PERMISSIONS.SETTINGS_GALLERY)) {
  return Astro.redirect('/admin');
}
const settings = await getSettings();
---
<AdminLayout user={user} title="照片模式">
  <SettingsGallery client:load settings={settings} />
</AdminLayout>
