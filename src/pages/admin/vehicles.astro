---
import AdminDashboard from '@/components/AdminDashboard.svelte';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSession, hasAnyUsers } from '@/lib/auth';
import { listBrandAliases } from '@/lib/brand-aliases';
import { PERMISSIONS, hasPermission } from '@/lib/permissions';
import { getSettings } from '@/lib/settings';
import { listAdminVehicles } from '@/lib/vehicles';
import { createD1Db } from '@/db/d1';

const runtime = Astro.locals.runtime;
const binding = runtime?.env?.DB_PREVIEW;
const sessionSecret = runtime?.env?.SESSION_SECRET;
if (runtime && (!binding || !sessionSecret)) return new Response('Preview database unavailable', { status: 503 });
const adapter = binding ? await createD1Db(binding) : undefined;
const authOptions = { db: adapter, sessionSecret };

if (!await hasAnyUsers(authOptions)) return Astro.redirect('/admin/setup');
const user = await getSession(Astro.cookies, authOptions);
if (!user) return Astro.redirect('/admin/login');
if (user.role !== 'superadmin' && !hasPermission(user.permissions, PERMISSIONS.VEHICLES_VIEW)) {
  return Astro.redirect('/admin');
}

const vehicles = await listAdminVehicles(adapter, adapter ? 100 : undefined);
const settings = await getSettings(adapter);
const brandAliases = await listBrandAliases(adapter, adapter ? 100 : undefined);
---

<AdminLayout user={user}>
  <AdminDashboard client:load mode="vehicles" vehicles={vehicles} settings={settings} brandAliases={brandAliases} />
</AdminLayout>
