---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ShareButton from '@/components/ShareButton.astro';
import { getSettings, socialIconCropStyle } from '@/lib/settings';
import { formatVehicleShareText, shareOriginFromRequest, vehicleShareUrl } from '@/lib/vehicle-share';
import { getVehicleBySlug, listPublicVehicles } from '@/lib/vehicles';
import { devPlaceholderSpecs } from '@/lib/dev-placeholder-vehicle-specs';

const vehicle = await getVehicleBySlug(Astro.params.slug || '');
if (!vehicle || !['published', 'sold'].includes(vehicle.status)) {
  return new Response('Not found', { status: 404 });
}
const settings = await getSettings();
const shareUrl = vehicleShareUrl(vehicle, shareOriginFromRequest(Astro.request, Astro.url));
const shareText = formatVehicleShareText(vehicle, settings.shareMessageTemplate, shareUrl);
const known = devPlaceholderSpecs[vehicle.slug] || {};
const advisorDescription = vehicle.description;
const allVehicles = await listPublicVehicles();
const currentIndex = allVehicles.findIndex((v) => v.id === vehicle.id);
const prevVehicle = currentIndex > 0 ? allVehicles[currentIndex - 1] : null;
const nextVehicle = currentIndex >= 0 && currentIndex < allVehicles.length - 1 ? allVehicles[currentIndex + 1] : null;

const origin = `${Astro.url.protocol}//${Astro.url.host}`;
const vehicleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: vehicle.title,
  brand: { '@type': 'Brand', name: vehicle.brandDisplayName || vehicle.brand },
  model: vehicle.model || undefined,
  vehicleModelDate: vehicle.year || undefined,
  bodyType: known.body || undefined,
  fuelType: known.fuel || undefined,
  numberOfDoors: known.doorsSeats ? known.doorsSeats.split('/')[0]?.trim() : undefined,
  color: vehicle.exteriorColor || undefined,
  vehicleInteriorColor: vehicle.interiorColor || undefined,
  mileageFromOdometer: vehicle.mileage ? { '@type': 'QuantitativeValue', value: vehicle.mileage } : undefined,
  image: vehicle.images.map((image) => new URL(image.url, origin).toString()),
  url: new URL(`/cars/${vehicle.slug}`, origin).toString(),
  description: vehicle.description || vehicle.headline,
  itemCondition: 'https://schema.org/UsedCondition',
  offers: {
    '@type': 'Offer',
    availability: vehicle.status === 'sold' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    priceCurrency: 'TWD',
    price: '0',
    priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'TWD', minPrice: 0, description: '價格請洽' },
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: origin },
    { '@type': 'ListItem', position: 2, name: '車輛收藏', item: new URL('/cars', origin).toString() },
    { '@type': 'ListItem', position: 3, name: vehicle.title, item: new URL(`/cars/${vehicle.slug}`, origin).toString() },
  ],
};
const specRows = [
  { key: 'year', label: '年份', value: vehicle.year },
  { key: 'mileage', label: '里程', value: vehicle.mileage },
  { key: 'warranty', label: '保固', value: known.warranty },
  { key: 'spec', label: '規格', value: known.spec || vehicle.headline },
  { key: 'body', label: '車型', value: known.body || [vehicle.model, vehicle.subModel].filter(Boolean).join(' ') },
  { key: 'fuel', label: '燃料', value: known.fuel },
  { key: 'exteriorColor', label: '外觀顏色', value: vehicle.exteriorColor },
  { key: 'interiorColor', label: '內裝顏色', value: vehicle.interiorColor },
  { key: 'doorsSeats', label: '車門 / 座位', value: known.doorsSeats },
  { key: 'cylinders', label: '缸數', value: known.cylinders },
  { key: 'horsepower', label: '馬力', value: known.horsepower },
  { key: 'price', label: '價格', value: '價格請洽' },
].filter((row) => settings.detailSpecFields.includes(row.key) && row.value);
---

<PublicLayout title={`${vehicle.title}｜${settings.siteName}`} description={vehicle.headline || vehicle.description} shareText={shareText} shareUrl={shareUrl} ogImage={vehicle.coverImage?.url} ogType="product" jsonLd={[vehicleJsonLd, breadcrumbJsonLd]}>
  <article class="detail-page luxury-enter">
    <section class="detail-hero">
      <div class="detail-copy">
        <p class="eyebrow">{vehicle.brandDisplayName}</p>
        <h1>{vehicle.title}</h1>
        <p class="detail-headline">{vehicle.headline || vehicle.condition}</p>
        <div class="detail-actions">
          <a class={`button button--primary detail-contact-button${settings.socialIcons.line ? ' detail-contact-button--custom' : ''}`} href={settings.lineUrl} aria-label="LINE 洽詢此車">
            {settings.socialIcons.line ? (
              <img class="brand-custom-img" src={settings.socialIcons.line.url} alt="LINE" style={socialIconCropStyle(settings.socialIcons.line)} loading="lazy" decoding="async" />
            ) : (
              <svg class="brand-glyph" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path d="M24 6C13.5 6 5 12.9 5 21.4c0 7.6 6.7 14 15.8 15.2.6.1 1.4.4 1.6.9.2.5.1 1.2.1 1.7l-.3 2c-.1.6-.5 2.3 1.7 1.3 2.2-1 11.7-6.9 16-11.8 3-3.3 4.1-6.4 4.1-9.3C43 12.9 34.5 6 24 6Z" />
                <text class="social-cutout" x="24" y="19" text-anchor="middle" dominant-baseline="central" font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-weight="900" font-size="13" letter-spacing="-0.6">LINE</text>
              </svg>
            )}
            <span>LINE 洽詢此車</span>
          </a>
          <a class={`button button--ghost detail-contact-button${settings.socialIcons.phone ? ' detail-contact-button--custom' : ''}`} href={`tel:${settings.phoneNumber}`} aria-label="電話聯絡">
            {settings.socialIcons.phone ? (
              <img class="brand-custom-img" src={settings.socialIcons.phone.url} alt="電話" style={socialIconCropStyle(settings.socialIcons.phone)} loading="lazy" decoding="async" />
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
            )}
            <span>電話聯絡</span>
          </a>
          <ShareButton class="detail-share-button" title={vehicle.title} url={shareUrl} text={shareText} />
        </div>
      </div>
      <div class="detail-cover">
        {vehicle.coverImage && <img src={vehicle.coverImage.url} alt={vehicle.coverImage.alt || `${vehicle.title} 封面照`} fetchpriority="high" decoding="async" />}
      </div>
    </section>
    <section class="detail-section reveal-section">
      <div class="section-kicker">
        <p class="eyebrow">車輛資訊</p>
        <h2>完整規格</h2>
      </div>
      <div class="spec-panel spec-panel--detail">
        {specRows.map(({ label, value }) => <div><span>{label}</span><strong>{value}</strong></div>)}
      </div>
    </section>
    <section class="story-grid reveal-section">
      <div>
        <p class="eyebrow">{settings.detailNotesEyebrow}</p>
        <h2>{settings.detailNotesTitle}</h2>
      </div>
      <div class="advisor-note">
        <p>{advisorDescription}</p>
        <p class="advisor-note__signature">— {settings.salespersonName}</p>
      </div>
    </section>
    {vehicle.images.length > 0 && (
      <div class="gallery-header reveal-section">
        <p class="eyebrow">完整圖庫</p>
        <span>共 {vehicle.images.length} 張</span>
      </div>
    )}
    <section class="gallery reveal-section">
      {vehicle.images.map((image, index) => (
        <button class="gallery-item" type="button" data-gallery-index={index} aria-label={`開啟第 ${index + 1} 張大圖`}>
          <img src={image.url} alt={image.alt || `${vehicle.title} 圖片 ${index + 1} / ${vehicle.images.length}`} loading="lazy" decoding="async" />
          <span class="gallery-item__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4M8 11h6M11 8v6" /></svg>
          </span>
          <span class="gallery-item__index" aria-hidden="true">{index + 1} / {vehicle.images.length}</span>
        </button>
      ))}
    </section>
    <nav class="detail-pager reveal-section" aria-label="車輛切換">
      {prevVehicle ? (
        <a class="detail-pager__link detail-pager__link--prev" href={`/cars/${prevVehicle.slug}`} rel="prev">
          <span class="eyebrow">上一台</span>
          <strong>{prevVehicle.title}</strong>
        </a>
      ) : (<span class="detail-pager__placeholder" aria-hidden="true"></span>)}
      <a class="detail-pager__home" href="/cars">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
        <span>回到車輛收藏</span>
      </a>
      {nextVehicle ? (
        <a class="detail-pager__link detail-pager__link--next" href={`/cars/${nextVehicle.slug}`} rel="next">
          <span class="eyebrow">下一台</span>
          <strong>{nextVehicle.title}</strong>
        </a>
      ) : (<span class="detail-pager__placeholder" aria-hidden="true"></span>)}
    </nav>
  </article>
  <div class="image-lightbox" aria-hidden="true" role="dialog" aria-label="車輛照片預覽">
    <span class="image-lightbox__counter" aria-live="polite">1 / 1</span>
    <button class="image-lightbox__close" type="button" aria-label="關閉大圖">×</button>
    <button class="image-lightbox__nav image-lightbox__nav--prev" type="button" aria-label="上一張">‹</button>
    <div class="image-lightbox__stage">
      <img src="" alt="" />
    </div>
    <button class="image-lightbox__nav image-lightbox__nav--next" type="button" aria-label="下一張">›</button>
    <div class="image-lightbox__toolbar" aria-label="縮放控制">
      <button type="button" data-zoom="out" aria-label="縮小">−</button>
      <span>1x</span>
      <button type="button" data-zoom="in" aria-label="放大">＋</button>
    </div>
  </div>
  <script is:inline define:vars={{ images: vehicle.images.map((image) => ({ url: image.url, alt: image.alt || vehicle.title })) }}>
    const lightbox = document.querySelector('.image-lightbox');
    const lightboxImage = lightbox?.querySelector('img');
    const zoomLabel = lightbox?.querySelector('.image-lightbox__toolbar span');
    const counter = lightbox?.querySelector('.image-lightbox__counter');
    const stage = lightbox?.querySelector('.image-lightbox__stage');
    const galleryButtons = Array.from(document.querySelectorAll('[data-gallery-index]'));
    let activeIndex = 0;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let dragStart = null;
    let pinchStart = null;
    let lastTapTime = 0;

    const clampScale = (value) => Math.min(4, Math.max(1, value));
    const applyTransform = () => {
      if (!lightboxImage) return;
      lightboxImage.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      if (zoomLabel) zoomLabel.textContent = `${scale.toFixed(scale % 1 ? 1 : 0)}x`;
    };
    const resetTransform = () => {
      scale = 1;
      translateX = 0;
      translateY = 0;
      applyTransform();
    };
    const toggleZoom = () => {
      scale = scale === 1 ? 2.5 : 1;
      translateX = 0;
      translateY = 0;
      applyTransform();
    };
    const showImage = (index) => {
      activeIndex = (index + images.length) % images.length;
      if (!lightboxImage) return;
      lightboxImage.src = images[activeIndex].url;
      lightboxImage.alt = images[activeIndex].alt;
      if (counter) counter.textContent = `${activeIndex + 1} / ${images.length}`;
      resetTransform();
    };
    let previouslyFocused = null;
    const focusableSelector = '.image-lightbox__close, .image-lightbox__nav, .image-lightbox__toolbar button';
    const openLightbox = (index) => {
      if (!lightbox || !images.length) return;
      previouslyFocused = document.activeElement;
      showImage(index);
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('has-open-lightbox');
      const firstFocusable = lightbox.querySelector(focusableSelector);
      if (firstFocusable instanceof HTMLElement) firstFocusable.focus();
    };
    const closeLightbox = () => {
      lightbox?.classList.remove('is-open');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('has-open-lightbox');
      resetTransform();
      if (previouslyFocused instanceof HTMLElement) previouslyFocused.focus();
    };
    const zoomBy = (delta) => {
      scale = clampScale(scale + delta);
      if (scale === 1) {
        translateX = 0;
        translateY = 0;
      }
      applyTransform();
    };
    const touchDistance = (touches) => Math.hypot(touches[0].clientX - touches[1].clientX, touches[0].clientY - touches[1].clientY);

    galleryButtons.forEach((button) => {
      button.addEventListener('click', () => openLightbox(Number(button.dataset.galleryIndex || 0)));
    });
    lightbox?.querySelector('.image-lightbox__close')?.addEventListener('click', closeLightbox);
    lightbox?.querySelector('.image-lightbox__nav--prev')?.addEventListener('click', () => showImage(activeIndex - 1));
    lightbox?.querySelector('.image-lightbox__nav--next')?.addEventListener('click', () => showImage(activeIndex + 1));
    lightbox?.querySelector('[data-zoom="in"]')?.addEventListener('click', () => zoomBy(0.5));
    lightbox?.querySelector('[data-zoom="out"]')?.addEventListener('click', () => zoomBy(-0.5));
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    stage?.addEventListener('dblclick', (event) => {
      event.preventDefault();
      toggleZoom();
    });
    stage?.addEventListener('wheel', (event) => {
      event.preventDefault();
      zoomBy(event.deltaY < 0 ? 0.25 : -0.25);
    }, { passive: false });
    stage?.addEventListener('pointerdown', (event) => {
      if (scale <= 1) return;
      stage.setPointerCapture(event.pointerId);
      dragStart = { x: event.clientX, y: event.clientY, translateX, translateY };
    });
    stage?.addEventListener('pointermove', (event) => {
      if (!dragStart) return;
      translateX = dragStart.translateX + event.clientX - dragStart.x;
      translateY = dragStart.translateY + event.clientY - dragStart.y;
      applyTransform();
    });
    stage?.addEventListener('pointerup', () => { dragStart = null; });
    stage?.addEventListener('pointercancel', () => { dragStart = null; });
    stage?.addEventListener('touchstart', (event) => {
      if (event.touches.length === 2) pinchStart = { distance: touchDistance(event.touches), scale };
    }, { passive: true });
    stage?.addEventListener('touchmove', (event) => {
      if (event.touches.length !== 2 || !pinchStart) return;
      event.preventDefault();
      scale = clampScale(pinchStart.scale * (touchDistance(event.touches) / pinchStart.distance));
      applyTransform();
    }, { passive: false });
    stage?.addEventListener('touchend', (event) => {
      pinchStart = null;
      if (event.touches.length || event.changedTouches.length !== 1) return;
      const now = Date.now();
      if (now - lastTapTime < 320) {
        event.preventDefault();
        toggleZoom();
        lastTapTime = 0;
        return;
      }
      lastTapTime = now;
    }, { passive: false });
    document.addEventListener('keydown', (event) => {
      if (!lightbox?.classList.contains('is-open')) return;
      if (event.key === 'Escape') { closeLightbox(); return; }
      if (event.key === 'ArrowLeft') { showImage(activeIndex - 1); return; }
      if (event.key === 'ArrowRight') { showImage(activeIndex + 1); return; }
      if (event.key === 'Tab') {
        const focusables = Array.from(lightbox.querySelectorAll(focusableSelector)).filter((el) => el instanceof HTMLElement && !el.hasAttribute('disabled'));
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  </script>
</PublicLayout>
