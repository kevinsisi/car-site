---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ShareButton from '@/components/ShareButton.astro';
import { getSettings } from '@/lib/settings';
import { getVehicleBySlug } from '@/lib/vehicles';

const vehicle = await getVehicleBySlug(Astro.params.slug || '');
if (!vehicle || !['published', 'sold'].includes(vehicle.status)) {
  return new Response('Not found', { status: 404 });
}
const settings = await getSettings();
const specRows = [
  ['年份', vehicle.year || '請洽詢'],
  ['里程', vehicle.mileage || '請洽詢'],
  ['保固', '請洽詢'],
  ['規格', vehicle.headline || '請洽詢'],
  ['車型', [vehicle.model, vehicle.subModel].filter(Boolean).join(' ') || '請洽詢'],
  ['燃料', '請洽詢'],
  ['外觀顏色', vehicle.exteriorColor || '請洽詢'],
  ['內裝顏色', vehicle.interiorColor || '請洽詢'],
  ['車門 / 座位', '請洽詢'],
  ['缸數', '請洽詢'],
  ['馬力', '請洽詢'],
  ['價格', '價格請洽'],
];
---

<PublicLayout title={`${vehicle.title}｜${settings.siteName}`} description={vehicle.headline || vehicle.description}>
  <article class="detail-page luxury-enter">
    <section class="detail-hero">
      <div class="detail-copy">
        <p class="eyebrow">{vehicle.brandDisplayName}</p>
        <h1>{vehicle.title}</h1>
        <p class="detail-headline">{vehicle.headline || vehicle.condition}</p>
        <div class="detail-actions">
          <a class="button button--primary" href={settings.lineUrl}>LINE 洽詢此車</a>
          <a class="button button--ghost" href={`tel:${settings.phoneNumber}`}>電話聯絡</a>
          <ShareButton title={vehicle.title} url={`/cars/${vehicle.slug}`} text={`${vehicle.title}｜${vehicle.year || vehicle.brandDisplayName}，價格請洽。`} />
        </div>
      </div>
      <div class="detail-cover">
        {vehicle.coverImage && <img src={vehicle.coverImage.url} alt={vehicle.coverImage.alt || vehicle.title} fetchpriority="high" decoding="async" />}
      </div>
    </section>
    <section class="detail-section reveal-section">
      <div class="section-kicker">
        <p class="eyebrow">Vehicle Information</p>
        <h2>完整規格</h2>
      </div>
      <div class="spec-panel spec-panel--detail">
        {specRows.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
      </div>
    </section>
    <section class="story-grid reveal-section">
      <div>
        <p class="eyebrow">{settings.detailNotesEyebrow}</p>
        <h2>{settings.detailNotesTitle}</h2>
      </div>
      <p>{vehicle.description}</p>
    </section>
    <section class="feature-list reveal-section">
      {vehicle.features.map((feature) => <span>{feature}</span>)}
    </section>
    <section class="gallery reveal-section">
      {vehicle.images.map((image) => <img src={image.url} alt={image.alt || vehicle.title} loading="lazy" decoding="async" />)}
    </section>
  </article>
</PublicLayout>
