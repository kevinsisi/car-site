---
import PublicLayout from '@/layouts/PublicLayout.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { getSettings } from '@/lib/settings';
import { getVehicleBySlug, listPublicInventoryVehicles } from '@/lib/vehicles';

const settings = await getSettings();
const idsParam = Astro.url.searchParams.get('ids') || '';
const slugs = idsParam.split(',').map((s) => s.trim()).filter(Boolean);

const [vehicles, allVehicles] = await Promise.all([
  Promise.all(slugs.map((slug) => getVehicleBySlug(slug))).then((r) => r.filter(Boolean)),
  listPublicInventoryVehicles(),
]);

// Vehicles available to add (not already in compare)
const availableVehicles = allVehicles.filter((v) => !slugs.includes(v.slug));

const specRows = [
  { key: 'year', label: '年份' },
  { key: 'mileage', label: '里程' },
  { key: 'condition', label: '車況' },
  { key: 'exteriorColor', label: '外觀顏色' },
  { key: 'interiorColor', label: '內裝顏色' },
  { key: 'brandDisplayName', label: '品牌' },
  { key: 'model', label: '型號' },
  { key: 'subModel', label: '規格' },
];

function removeUrl(slug: string): string {
  const remaining = slugs.filter((s) => s !== slug);
  return remaining.length ? `/cars/compare?ids=${remaining.join(',')}` : '/cars/compare';
}

function addUrl(slug: string): string {
  return `/cars/compare?ids=${[...slugs, slug].join(',')}`;
}

function getVal(v: NonNullable<typeof vehicles[number]>, key: string): string {
  return (v as unknown as Record<string, unknown>)[key] as string || '—';
}
---

<PublicLayout title={`車輛比較｜${settings.siteName}`} description="比較多款車輛規格">
  <div class="compare-page">
    <div class="compare-page__header">
      <p class="eyebrow">車輛比較</p>
      <h1>規格比較</h1>
    </div>

    {vehicles.length === 0 ? (
      <div class="compare-empty">
        <p>尚未選擇任何車輛</p>
        <p class="muted">在車輛列表點選「＋ 比較」，就會出現在這裡。</p>
        <a href="/cars" class="btn-primary" style="margin-top:1rem;display:inline-block">瀏覽車輛</a>
      </div>
    ) : (
      <div class="compare-table-wrapper">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="compare-label-col"></th>
              {vehicles.map((v) => (
                <th class="compare-vehicle-col">
                  <div class="compare-vehicle-header">
                    {v!.coverImage && (
                      <a href={`/cars/${v!.slug}`}>
                        <img src={v!.coverImage.thumbUrl || v!.coverImage.url} alt={v!.title} loading="lazy" class="compare-vehicle-img" />
                      </a>
                    )}
                    <div class="compare-vehicle-title">
                      <BrandIcon iconUrl={v!.brandIconUrl} alt={v!.brandDisplayName} size={20} />
                      <a href={`/cars/${v!.slug}`}>{v!.cardTitle}</a>
                    </div>
                    <a href={removeUrl(v!.slug)} class="compare-remove">✕ 移除</a>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {specRows.map((row) => (
              <tr>
                <td class="compare-label">{row.label}</td>
                {vehicles.map((v) => (
                  <td class="compare-value">{getVal(v!, row.key)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {/* Add vehicle section */}
    {availableVehicles.length > 0 && (
      <div class="compare-add-section">
        <h2>新增車輛比較</h2>
        <div class="compare-search-wrap">
          <input
            type="search"
            id="compare-search"
            placeholder="搜尋車輛品牌、型號、年份..."
            class="compare-search-input"
            autocomplete="off"
          />
        </div>
        <div class="compare-add-list" id="compare-add-list">
          {availableVehicles.map((v) => (
            <a
              href={addUrl(v.slug)}
              class="compare-add-item"
              data-search={`${v.brandDisplayName} ${v.model} ${v.year} ${v.cardTitle}`.toLowerCase()}
            >
              {v.coverImage && <img src={v.coverImage.thumbUrl || v.coverImage.url} alt={v.title} loading="lazy" />}
              <div class="compare-add-info">
                <span class="compare-add-brand">{v.brandDisplayName}</span>
                <span class="compare-add-title">{v.cardTitle}</span>
              </div>
              <span class="compare-add-btn">＋ 加入</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="compare-page__footer">
      <a href="/cars" class="btn-secondary">← 返回車輛列表</a>
      {vehicles.length > 0 && (
        <a href="/cars/compare" class="btn-secondary" style="margin-left:0.75rem">清除全部</a>
      )}
    </div>
  </div>
</PublicLayout>

<script>
  // If page loaded without ?ids but localStorage has slugs, redirect with them
  const urlIds = new URLSearchParams(location.search).get('ids');
  if (!urlIds) {
    const stored: string[] = JSON.parse(localStorage.getItem('compare_slugs') || '[]');
    if (stored.length > 0) {
      location.replace(`/cars/compare?ids=${stored.join(',')}`);
    }
  } else {
    // Sync URL slugs back to localStorage so CompareBar stays in sync
    localStorage.setItem('compare_slugs', JSON.stringify(urlIds.split(',').filter(Boolean)));
    window.dispatchEvent(new CustomEvent('compare-changed'));
  }

  const searchInput = document.getElementById('compare-search') as HTMLInputElement | null;
  const list = document.getElementById('compare-add-list');

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    list?.querySelectorAll<HTMLElement>('.compare-add-item').forEach((item) => {
      const match = !q || (item.dataset.search || '').includes(q);
      item.style.display = match ? '' : 'none';
    });
  });
</script>

<style>
.compare-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 6rem; }
.compare-page__header { margin-bottom: 2rem; }
.compare-page__header h1 { margin: 0.5rem 0 0; }
.compare-empty { text-align: center; padding: 4rem 1rem; }
.compare-empty p { margin-bottom: 0.5rem; }
.compare-table-wrapper { overflow-x: auto; margin-bottom: 2rem; }
.compare-table { width: 100%; border-collapse: collapse; min-width: 400px; }
.compare-table th, .compare-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border, #e5e5e5); vertical-align: top; text-align: left; }
.compare-label-col { width: 100px; min-width: 80px; }
.compare-vehicle-col { min-width: 180px; }
.compare-label { font-weight: 600; font-size: 0.85rem; color: var(--muted, #777); }
.compare-value { font-size: 0.9rem; }
.compare-vehicle-header { display: flex; flex-direction: column; gap: 0.5rem; }
.compare-vehicle-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 4px; }
.compare-vehicle-title { display: flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; font-weight: 600; }
.compare-vehicle-title a { text-decoration: none; color: inherit; }
.compare-remove { font-size: 0.8rem; color: var(--muted, #777); text-decoration: none; }
.compare-remove:hover { color: #c00; }

/* Add section */
.compare-add-section { margin: 2rem 0; }
.compare-add-section h2 { font-size: 1.1rem; margin-bottom: 1rem; }
.compare-search-wrap { margin-bottom: 1rem; }
.compare-search-input {
  width: 100%; max-width: 400px;
  padding: 0.6rem 1rem;
  border: 1px solid var(--border, #ddd);
  border-radius: 8px;
  font-size: 0.95rem;
}
.compare-add-list { display: flex; flex-direction: column; gap: 0.5rem; max-height: 400px; overflow-y: auto; }
.compare-add-item {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.6rem 1rem;
  border: 1px solid var(--border, #e5e5e5);
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  transition: background 0.15s;
}
.compare-add-item:hover { background: var(--surface-soft, #f5f5f5); }
.compare-add-item img { width: 72px; height: 48px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
.compare-add-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.compare-add-brand { font-size: 0.75rem; color: var(--muted, #777); }
.compare-add-title { font-size: 0.875rem; font-weight: 600; }
.compare-add-btn { font-size: 0.8rem; color: var(--accent, #2f66ad); white-space: nowrap; flex-shrink: 0; }

.compare-page__footer { margin-top: 2rem; display: flex; gap: 0.75rem; }
</style>
