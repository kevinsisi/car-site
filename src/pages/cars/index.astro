---
import VehicleCard from '@/components/VehicleCard.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getSettings } from '@/lib/settings';
import { formatVehicleShareText, shareOriginFromRequest, vehicleShareUrl } from '@/lib/vehicle-share';
import { listMonthlyRecommendedVehicles, listPublicBrands, listPublicInventoryVehicles, listPublicVehiclesByBrand, listSoldVehicles } from '@/lib/vehicles';

const settings = await getSettings();
const activeBrand = Astro.url.searchParams.get('brand') || '';
const tabParam = Astro.url.searchParams.get('tab');
const searchQuery = (Astro.url.searchParams.get('q') || '').trim();
const activeTab = activeBrand ? 'brand' : tabParam === 'recommended' ? 'recommended' : tabParam === 'sold' ? 'sold' : 'all';
const allVehicles = await listPublicInventoryVehicles();
const recommendedVehicles = await listMonthlyRecommendedVehicles();
const soldVehicles = await listSoldVehicles();
const brands = await listPublicBrands();
const baseVehicles = activeTab === 'recommended' ? recommendedVehicles : activeTab === 'sold' ? soldVehicles : activeBrand ? await listPublicVehiclesByBrand(activeBrand) : allVehicles;
const activeBrandLabel = brands.find((brand) => brand.urlSlug === activeBrand)?.displayName;
const shareOrigin = shareOriginFromRequest(Astro.request, Astro.url);
const brandSuggestionMap = new Map<string, { value: string; kind: 'brand'; iconUrl: string | null; href: string }>();
for (const brand of brands) {
  if (!brand.displayName || !brand.urlSlug) continue;
  brandSuggestionMap.set(brand.displayName.toLowerCase(), {
    value: brand.displayName,
    kind: 'brand',
    iconUrl: brand.iconUrl,
    href: `/cars?brand=${brand.urlSlug}`,
  });
}
for (const vehicle of allVehicles) {
  if (!vehicle.brandDisplayName || !vehicle.brandUrlSlug) continue;
  const key = vehicle.brandDisplayName.toLowerCase();
  if (brandSuggestionMap.has(key)) continue;
  brandSuggestionMap.set(key, {
    value: vehicle.brandDisplayName,
    kind: 'brand',
    iconUrl: vehicle.brandIconUrl,
    href: `/cars?brand=${vehicle.brandUrlSlug}`,
  });
}
const brandSuggestions = Array.from(brandSuggestionMap.values()).sort((a, b) => a.value.localeCompare(b.value, 'zh-Hant'));
const brandSuggestionLabels = new Set(brandSuggestions.flatMap((brand) => [brand.value, brand.value.toLowerCase(), brand.href.replace('/cars?brand=', '').toLowerCase()]));
const vehicleSuggestions = Array.from(new Set(
  allVehicles.flatMap((vehicle) => [
    vehicle.model,
    vehicle.subModel,
    vehicle.year,
    vehicle.cardTitle,
    vehicle.title,
  ].filter((value): value is string => Boolean(value && String(value).trim())))
)).filter((value) => !brandSuggestionLabels.has(value) && !brandSuggestionLabels.has(value.toLowerCase()))
  .sort((a, b) => a.localeCompare(b, 'zh-Hant'))
  .map((value) => ({ value, kind: 'vehicle', iconUrl: null, href: '' }));
const searchSuggestions = [...brandSuggestions, ...vehicleSuggestions];

const SORT_OPTIONS = [
  { value: 'recent', label: '最近更新' },
  { value: 'year-desc', label: '年份：新到舊' },
  { value: 'year-asc', label: '年份：舊到新' },
  { value: 'mileage-asc', label: '里程：少到多' },
] as const;
type SortValue = (typeof SORT_OPTIONS)[number]['value'];
const sortParam = (Astro.url.searchParams.get('sort') || 'recent') as SortValue;
const activeSort = SORT_OPTIONS.find((opt) => opt.value === sortParam)?.value || 'recent';
const numericValue = (raw: string) => {
  const match = String(raw || '').replace(/[^\d.]/g, '');
  if (!match) return Number.NaN;
  const n = Number.parseFloat(match);
  return Number.isFinite(n) ? n : Number.NaN;
};
const matchesSearch = (vehicle: (typeof baseVehicles)[number]) => {
  if (!searchQuery) return true;
  const haystack = [vehicle.title, vehicle.cardTitle, vehicle.brand, vehicle.brandDisplayName, vehicle.model, vehicle.subModel, vehicle.year, vehicle.mileage, vehicle.condition, vehicle.slug]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return haystack.includes(searchQuery.toLowerCase());
};
const sortedVehicles = baseVehicles.filter(matchesSearch);
if (activeSort === 'year-desc') {
  sortedVehicles.sort((a, b) => (numericValue(b.year) || 0) - (numericValue(a.year) || 0));
} else if (activeSort === 'year-asc') {
  sortedVehicles.sort((a, b) => (numericValue(a.year) || 9999) - (numericValue(b.year) || 9999));
} else if (activeSort === 'mileage-asc') {
  sortedVehicles.sort((a, b) => (numericValue(a.mileage) || Infinity) - (numericValue(b.mileage) || Infinity));
}
const vehicles = sortedVehicles;
---

<PublicLayout title={`嚴選車輛｜${settings.siteName}`} showMobileActions={false} showBackToTop={false}>
  <section class="page-hero compact luxury-enter">
    <p class="eyebrow">{settings.listingEyebrow}</p>
    <h1>{settings.listingTitle}</h1>
    <p>{settings.listingLead}</p>
  </section>
  <section class="inventory-shell">
    <aside class="brand-filter-panel" id="brand-filter-panel" aria-label="品牌篩選">
      <div class="filter-panel__header">
        <p class="eyebrow">篩選</p>
        <button class="filter-close" type="button" aria-label="關閉品牌篩選">關閉</button>
      </div>
      <nav class="brand-list" aria-label="品牌列表">
        <a class={activeTab === 'all' ? 'is-active' : ''} href="/cars"><span>全部</span><strong>{allVehicles.length}</strong></a>
        <a class={activeTab === 'recommended' ? 'is-active' : ''} href="/cars?tab=recommended"><span>本月精選</span><strong>{recommendedVehicles.length}</strong></a>
        {brands.map((brand) => (
          <a class={activeBrand === brand.urlSlug ? 'is-active' : ''} href={`/cars?brand=${brand.urlSlug}`}><BrandIcon iconUrl={brand.iconUrl} alt="" size={20} class="brand-filter-icon" /><span>{brand.displayName}</span><strong>{brand.count}</strong></a>
        ))}
        <a class={`brand-list__sold ${activeTab === 'sold' ? 'is-active' : ''}`} href="/cars?tab=sold"><span>成交實錄</span><strong>{soldVehicles.length}</strong></a>
      </nav>
    </aside>
    <div class="filter-scrim" aria-hidden="true"></div>
    <div class="inventory-content">
      <div class="inventory-toolbar">
        <div>
          <p class="eyebrow">選車</p>
          <h2>{searchQuery || activeBrandLabel || (activeTab === 'recommended' ? '本月精選' : activeTab === 'sold' ? '成交實錄' : '全部車輛')}</h2>
        </div>
        <div class="inventory-toolbar__controls">
          <label class="sort-control">
            <span>排序</span>
            <select id="sort-select" aria-label="車輛排序">
              {SORT_OPTIONS.map((opt) => (
                <option value={opt.value} selected={activeSort === opt.value}>{opt.label}</option>
              ))}
            </select>
          </label>
          <span class="vehicle-count">{vehicles.length} 台車</span>
        </div>
        <nav class="mobile-filter-strip" aria-label="車輛篩選">
          <form class="listing-search" action="/cars" method="get" role="search">
            {activeBrand && <input type="hidden" name="brand" value={activeBrand} />}
            {!activeBrand && activeTab !== 'all' && <input type="hidden" name="tab" value={activeTab} />}
            {activeSort !== 'recent' && <input type="hidden" name="sort" value={activeSort} />}
            <div class="autocomplete-field">
              <input type="search" name="q" value={searchQuery} placeholder="搜尋車款、品牌、年份" aria-label="搜尋車輛" list="vehicle-search-suggestions" autocomplete="off" data-suggestion-submit />
              <datalist id="vehicle-search-suggestions">
                {searchSuggestions.map((suggestion) => <option value={suggestion.value} data-kind={suggestion.kind} data-icon={suggestion.iconUrl || ''} data-href={suggestion.href} />)}
              </datalist>
              <div class="search-suggestions" role="listbox" aria-label="搜尋建議"></div>
            </div>
          </form>
          <button class={`filter-toggle ${activeBrandLabel || activeTab === 'recommended' || activeTab === 'sold' ? 'is-active' : ''}`} type="button" aria-expanded="false" aria-controls="brand-filter-panel">{activeBrandLabel || (activeTab === 'recommended' ? '本月精選' : activeTab === 'sold' ? '成交實錄' : '品牌列表')}</button>
        </nav>
      </div>
      {vehicles.length === 0 ? (
        <div class="empty-state">
          <p class="eyebrow">目前無符合車輛</p>
          <h3>這個分類暫時沒有上架的車輛</h3>
          <p>歡迎透過 <a href={settings.lineUrl}>LINE 洽詢</a> 告訴我們想找的品牌、年份或預算，我們會主動協助尋車。</p>
          <a class="button button--ghost" href="/cars">查看全部車輛</a>
        </div>
      ) : (
        <div class="vehicle-grid listing-grid">
          {vehicles.map((vehicle) => <VehicleCard vehicle={vehicle} shareText={formatVehicleShareText(vehicle, settings.shareMessageTemplate, vehicleShareUrl(vehicle, shareOrigin))} />)}
        </div>
      )}
    </div>
  </section>
  <script>
    const shell = document.querySelector('.inventory-shell');
    const toggle = document.querySelector('.filter-toggle');
    const close = document.querySelector('.filter-close');
    const scrim = document.querySelector('.filter-scrim');
    const setOpen = (open: boolean) => {
      shell?.classList.toggle('is-filter-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('has-open-filter', open);
    };
    toggle?.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));
    scrim?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    const sortSelect = document.getElementById('sort-select');
    sortSelect?.addEventListener('change', (event) => {
      const target = event.currentTarget as HTMLSelectElement;
      const url = new URL(window.location.href);
      if (target.value === 'recent') url.searchParams.delete('sort');
      else url.searchParams.set('sort', target.value);
      window.location.href = url.toString();
    });

    let lastCarsScrollY = window.scrollY;
    const updateCarsCompact = () => {
      if (!window.matchMedia('(max-width: 760px)').matches) return;
      const current = window.scrollY;
      const scrollingDown = current > lastCarsScrollY + 18;
      const scrollingUp = current < lastCarsScrollY - 10;
      if (scrollingDown && current > 120) document.body.classList.add('cars-compact-scroll');
      if (scrollingUp || current < 40) document.body.classList.remove('cars-compact-scroll');
      if (scrollingDown || scrollingUp) lastCarsScrollY = current;
    };
    updateCarsCompact();
    window.addEventListener('scroll', updateCarsCompact, { passive: true });

    const setupSearchSuggestions = (input: HTMLInputElement) => {
      const listId = input.getAttribute('list');
      const datalist = listId ? document.getElementById(listId) : null;
      const panel = input.parentElement?.querySelector<HTMLElement>('.search-suggestions');
      const suggestions = Array.from(datalist?.querySelectorAll('option') || [])
        .map((option) => ({
          value: option.value.trim(),
          kind: option.dataset.kind || 'vehicle',
          icon: option.dataset.icon || '',
          href: option.dataset.href || '',
        }))
        .filter((item) => item.value);
      if (!panel || suggestions.length === 0) return;

      input.removeAttribute('list');

      const hide = () => {
        panel.hidden = true;
        panel.innerHTML = '';
      };
      const render = () => {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          hide();
          return;
        }
        const matches = suggestions
          .filter((item) => item.value.toLowerCase().includes(q))
          .sort((a, b) => {
            const aBrand = a.kind === 'brand' ? 0 : 1;
            const bBrand = b.kind === 'brand' ? 0 : 1;
            const aStarts = a.value.toLowerCase().startsWith(q) ? 0 : 1;
            const bStarts = b.value.toLowerCase().startsWith(q) ? 0 : 1;
            return aBrand - bBrand || aStarts - bStarts || a.value.localeCompare(b.value, 'zh-Hant');
          })
          .slice(0, 6);
        if (matches.length === 0) {
          hide();
          return;
        }
        panel.replaceChildren(...matches.map((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.setAttribute('role', 'option');
          button.dataset.value = item.value;
          button.dataset.href = item.href;
          if (item.kind === 'brand') button.classList.add('is-brand');
          if (item.kind === 'brand' && item.icon) {
            const img = document.createElement('img');
            img.src = item.icon;
            img.alt = '';
            img.loading = 'lazy';
            button.append(img);
          }
          const label = document.createElement('span');
          label.textContent = item.value;
          button.append(label);
          return button;
        }));
        panel.hidden = false;
      };

      panel.hidden = true;
      input.addEventListener('input', render);
      input.addEventListener('focus', render);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hide();
      });
      input.addEventListener('blur', () => window.setTimeout(hide, 120));
      panel.addEventListener('pointerdown', (event) => event.preventDefault());
      panel.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest('button');
        if (!button) return;
        const href = button.dataset.href || '';
        const value = button.dataset.value || button.textContent || '';
        if (href) {
          window.location.href = href;
          return;
        }
        input.value = value;
        hide();
        input.form?.requestSubmit();
      });
    };

    document.querySelectorAll<HTMLInputElement>('input[data-suggestion-submit]').forEach(setupSearchSuggestions);
  </script>
  <style>
    .brand-list a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .brand-filter-icon {
      flex-shrink: 0;
    }
  </style>
</PublicLayout>
