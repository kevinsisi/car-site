---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getSettings } from '@/lib/settings';

const settings = await getSettings();
const contactItems = [
  ['實體門市', '台北市信義區範例路 00 號 0 樓', '#'],
  ['預約電話', settings.phoneNumber, `tel:${settings.phoneNumber}`],
  ['官方 LINE', '點擊加入 LINE 洽詢', settings.lineUrl],
  ['營業時間', '週一至週六 10:00-19:00，採預約賞車', '#'],
];
---

<PublicLayout title={`聯絡｜${settings.siteName}`} description="預約賞車、LINE 洽詢與門市資訊。">
  <section class="page-hero compact luxury-enter">
    <p class="eyebrow">聯絡我們</p>
    <h1>先聊需求，再安排最有效率的賞車時間。</h1>
    <p>高級車交易需要足夠資訊與信任。請透過 LINE 或電話留下需求，我們會協助確認車況與安排現場細看。</p>
  </section>
  <section class="contact-card-grid reveal-section">
    {contactItems.map(([title, body, href]) => (
      <a href={href} class="contact-card">
        <span class="promise-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11.4A7 7 0 1 0 5 9.6C5 15.8 12 21 12 21Z" /><path d="M9.5 9.7a2.5 2.5 0 1 0 5 0 2.5 2.5 0 0 0-5 0Z" /></svg></span>
        <span>{title}</span>
        <strong>{body}</strong>
      </a>
    ))}
  </section>
</PublicLayout>
