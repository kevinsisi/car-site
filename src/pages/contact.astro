---
import PublicLayout from '@/layouts/PublicLayout.astro';
import PremiumIcon from '@/components/PremiumIcon.astro';
import { getSettings } from '@/lib/settings';

const settings = await getSettings();
const mapQuery = settings.storeAddress ? encodeURIComponent(settings.storeAddress) : '';
const mapHref = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${mapQuery}` : '#';
const mapEmbedSrc = mapQuery ? `https://www.google.com/maps?q=${mapQuery}&output=embed` : '';
const contactItems = [
  {
    title: '預約電話',
    body: settings.phoneNumber,
    href: `tel:${settings.phoneNumber}`,
    icon: 'phone',
  },
  {
    title: '官方 LINE',
    body: '點擊加入 LINE 洽詢',
    href: settings.lineUrl,
    icon: 'chat',
  },
  {
    title: '營業時間',
    body: settings.businessHours || '週一至週六 10:00-19:00，採預約賞車',
    href: '#',
    icon: 'clock',
  },
];
---

<PublicLayout title={`聯絡｜${settings.siteName}`} description="預約賞車、LINE 洽詢與門市資訊。">
  <section class="page-hero compact luxury-enter">
    <p class="eyebrow">聯絡我們</p>
    <h1>先聊需求，再安排最有效率的賞車時間。</h1>
    <p>高級車交易需要足夠資訊與信任。請透過 LINE 或電話留下需求，我們會協助確認車況與安排現場細看。</p>
  </section>
  <section class="contact-card-grid reveal-section">
    {contactItems.map(({ title, body, href, icon }) => (
      <a href={href} class="contact-card">
        <span class="promise-icon" aria-hidden="true">
          {icon === 'store' && <PremiumIcon platform="store" />}
          {icon === 'phone' && <PremiumIcon platform="phone" label="電話" customIcon={settings.socialIcons.phone} />}
          {icon === 'chat' && <PremiumIcon platform="line" label="LINE" customIcon={settings.socialIcons.line} />}
          {icon === 'clock' && <PremiumIcon platform="clock" />}
        </span>
        <span>{title}</span>
        <strong>{body}</strong>
      </a>
    ))}
  </section>
  {settings.storeAddress && (
    <section class="location-section location-section--contact reveal-section" aria-labelledby="contact-location-title">
      <div class="location-section__copy">
        <p class="eyebrow">Location</p>
        <h2 id="contact-location-title">實體門市 / 預約賞車</h2>
        <p>{settings.storeAddress}</p>
        <span>{settings.businessHours || '採預約制賞車，來訪前請先以 LINE 或電話確認時間。'}</span>
        <a href={mapHref} target="_blank" rel="noopener noreferrer">在 Google 地圖開啟</a>
      </div>
      {mapEmbedSrc && (
        <iframe
          class="location-section__map"
          src={mapEmbedSrc}
          title={`${settings.siteName} Google 地圖`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      )}
    </section>
  )}
</PublicLayout>
