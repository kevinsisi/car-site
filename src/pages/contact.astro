---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getSettings } from '@/lib/settings';

const settings = await getSettings();
const contactItems = [
  {
    title: '實體門市',
    body: settings.storeAddress || '預約後提供精確位置',
    href: '#',
    icon: 'store',
  },
  {
    title: '預約電話',
    body: settings.phoneNumber,
    href: `tel:${settings.phoneNumber}`,
    icon: 'phone',
  },
  {
    title: '官方 LINE',
    body: '點擊加入 LINE 洽詢',
    href: settings.lineUrl,
    icon: 'chat',
  },
  {
    title: '營業時間',
    body: settings.businessHours || '週一至週六 10:00-19:00，採預約賞車',
    href: '#',
    icon: 'clock',
  },
];
---

<PublicLayout title={`聯絡｜${settings.siteName}`} description="預約賞車、LINE 洽詢與門市資訊。">
  <section class="page-hero compact luxury-enter">
    <p class="eyebrow">聯絡我們</p>
    <h1>先聊需求，再安排最有效率的賞車時間。</h1>
    <p>高級車交易需要足夠資訊與信任。請透過 LINE 或電話留下需求，我們會協助確認車況與安排現場細看。</p>
  </section>
  <section class="contact-card-grid reveal-section">
    {contactItems.map(({ title, body, href, icon }) => (
      <a href={href} class="contact-card">
        <span class="promise-icon" aria-hidden="true">
          {icon === 'store' && (
            <svg viewBox="0 0 24 24"><path d="M4 9.5 5.5 5h13L20 9.5v1.5a2.5 2.5 0 0 1-4.5 1.5 2.5 2.5 0 0 1-4 0 2.5 2.5 0 0 1-4 0 2.5 2.5 0 0 1-3.5-1.5v-1.5Z" /><path d="M5 11.5V20h14v-8.5" /><path d="M10 20v-5h4v5" /></svg>
          )}
          {icon === 'phone' && (
            <svg viewBox="0 0 24 24"><path d="M7.4 4.8 9.6 9c.3.6.2 1.3-.3 1.8l-1.1 1.1a12.3 12.3 0 0 0 4.9 4.9l1.1-1.1c.5-.5 1.2-.6 1.8-.3l4.2 2.2c.7.4 1 1.2.8 1.9-.4 1.5-1.7 2.5-3.2 2.5C9.1 22 2 14.9 2 6.2 2 4.7 3 3.4 4.5 3c.8-.2 1.6.1 1.9.8Z" /></svg>
          )}
          {icon === 'chat' && (
            <svg viewBox="0 0 24 24"><path d="M21 11c0 4-4 7.2-9 7.2-.7 0-1.4-.05-2.05-.15L5.4 21l1.45-3.4C4.7 16.3 3 13.8 3 11c0-4 4-7.2 9-7.2s9 3.2 9 7.2Z" /></svg>
          )}
          {icon === 'clock' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
          )}
        </span>
        <span>{title}</span>
        <strong>{body}</strong>
      </a>
    ))}
  </section>
</PublicLayout>
