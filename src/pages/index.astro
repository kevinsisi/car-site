---
import PublicLayout from '@/layouts/PublicLayout.astro';
import VehicleCard from '@/components/VehicleCard.astro';
import BrandStrip from '@/components/BrandStrip.astro';
import VideoCarousel from '@/components/VideoCarousel.astro';
import VideoLinksSection from '@/components/VideoLinksSection.astro';
import { getSettings } from '@/lib/settings';
import { formatVehicleShareText, shareOriginFromRequest, vehicleShareUrl } from '@/lib/vehicle-share';
import { listPublicVehicles, listSoldCaseVehicles, listPublicBrands } from '@/lib/vehicles';
import { listVideoLinks } from '@/lib/video-links';

const settings = await getSettings();
const vehicles = await listPublicVehicles();
const soldCaseVehicles = await listSoldCaseVehicles(6);
const brands = await listPublicBrands();
const videoLinks = await listVideoLinks();
const featuredVehicles = vehicles.filter((vehicle) => vehicle.status !== 'sold');
const heroBySlug = settings.heroVehicleSlug ? featuredVehicles.find((v) => v.slug === settings.heroVehicleSlug) : null;
const hero = heroBySlug || featuredVehicles[0] || soldCaseVehicles[0];
const shareOrigin = shareOriginFromRequest(Astro.request, Astro.url);
const featuredCount = Math.max(1, Math.min(12, settings.featuredCount ?? 3));
const mapQuery = settings.storeAddress ? encodeURIComponent(settings.storeAddress) : '';
const mapHref = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${mapQuery}` : '';
const mapEmbedSrc = mapQuery ? `https://www.google.com/maps?q=${mapQuery}&output=embed` : '';
---

<PublicLayout title={`私人高級車顧問｜${settings.siteName}`}>
  <section class="hero luxury-enter">
    <div class="hero__copy">
      <p class="eyebrow">{settings.homepageEyebrow}</p>
      <h1>{settings.homepageTitle}</h1>
      <p class="hero__lead">{settings.homepageLead}</p>
      <div class="cta-row">
        <a class="button button--primary" href={settings.lineUrl}>LINE 洽詢</a>
        <a class="button button--ghost" href={`tel:${settings.phoneNumber}`}>立即來電</a>
      </div>
    </div>
    <div class="hero__media">
      {hero?.coverImage && <img src={hero.coverImage.url} alt={hero.title} fetchpriority="high" decoding="async" />}
      <div class="hero__badge">{settings.homepageBadge}</div>
    </div>
  </section>

  <section class="salon-note reveal-section">
    <p>{settings.homepageNote}</p>
  </section>

  <section class="section-heading reveal-section">
    <p class="eyebrow">{settings.featuredEyebrow}</p>
    <h2>{settings.featuredTitle}</h2>
    <a href="/cars">查看全部</a>
  </section>
  {featuredVehicles.length > 0 && (
    <div class="vehicle-grid">
      {featuredVehicles.slice(0, featuredCount).map((vehicle) => <VehicleCard vehicle={vehicle} variant="featured" shareText={formatVehicleShareText(vehicle, settings.shareMessageTemplate, vehicleShareUrl(vehicle, shareOrigin))} />)}
    </div>
  )}

  {settings.videoSectionEnabled && settings.heroVideos.length > 0 && settings.videoSectionPosition === 'below-hero' && (
    <VideoCarousel videos={settings.heroVideos} />
  )}

  <BrandStrip brands={brands} eyebrow="車系品牌" />

  {settings.videoSectionEnabled && settings.heroVideos.length > 0 && settings.videoSectionPosition === 'below-featured' && (
    <VideoCarousel videos={settings.heroVideos} />
  )}

  {soldCaseVehicles.length > 0 && (
    <>
      <section class="section-heading section-heading--sold reveal-section">
        <p class="eyebrow">Delivered</p>
        <h2>成交案例</h2>
        <a href="/cars">瀏覽車庫</a>
      </section>
      <div class="vehicle-grid sold-case-grid">
        {soldCaseVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} variant="featured" shareText={formatVehicleShareText(vehicle, settings.shareMessageTemplate, vehicleShareUrl(vehicle, shareOrigin))} />)}
      </div>
    </>
  )}

  {settings.videoSectionEnabled && settings.heroVideos.length > 0 && settings.videoSectionPosition === 'above-footer' && (
    <VideoCarousel videos={settings.heroVideos} />
  )}

  {settings.videoLinksEnabled && videoLinks.length > 0 && (
    <VideoLinksSection links={videoLinks} sectionTitle={settings.videoLinksSectionTitle} />
  )}

  {settings.storeAddress && (
    <section class="location-section reveal-section" aria-labelledby="location-title">
      <div class="location-section__copy">
        <p class="eyebrow">Location</p>
        <h2 id="location-title">預約賞車位置</h2>
        <p>{settings.storeAddress}</p>
        {settings.businessHours && <span>{settings.businessHours}</span>}
        {mapHref && <a href={mapHref} target="_blank" rel="noopener noreferrer">在 Google 地圖開啟</a>}
      </div>
      {mapEmbedSrc && (
        <iframe
          class="location-section__map"
          src={mapEmbedSrc}
          title={`${settings.siteName} Google 地圖`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      )}
    </section>
  )}
</PublicLayout>
