<button id="export-btn" onclick="exportImage()">匯出圖片</button>

<script is:inline>
// ── Add-on calculator ──
const BASE_PRICE = 30000;
const FULL_PRICE = 60000;

function updateBasicTotal() {
  const checks = document.querySelectorAll('.addon-check');
  let extra = 0;
  let count = 0;
  const names = [];

  checks.forEach(cb => {
    if (cb.checked) {
      extra += parseInt(cb.dataset.price, 10);
      count++;
      names.push(cb.dataset.name);
    }
  });

  const total = BASE_PRICE + extra;
  document.getElementById('basic-total').textContent =
    'NT$' + total.toLocaleString('zh-TW');

  const countEl = document.getElementById('basic-addon-count');
  countEl.textContent = count === 0
    ? '不含主機年費'
    : `基礎 + ${count} 項選配・不含主機年費`;

  const noteEl = document.getElementById('basic-upgrade-note');
  noteEl.style.display = total >= FULL_PRICE ? 'block' : 'none';
}

document.querySelectorAll('.addon-check').forEach(cb => {
  cb.addEventListener('change', () => {
    const box = cb.nextElementSibling;
    const tag = box.nextElementSibling;
    box.classList.toggle('is-checked', cb.checked);
    tag.classList.toggle('is-checked', cb.checked);
    updateBasicTotal();
  });
});

// ── Export image ──
async function exportImage() {
  const btn = document.getElementById('export-btn');
  btn.textContent = '產生中…';
  btn.disabled = true;
  btn.style.display = 'none';

  const canvas = await html2canvas(document.querySelector('.page'), {
    scale: 2,
    backgroundColor: '#f5f5f5',
    useCORS: true,
    scrollY: -window.scrollY,
  });

  btn.style.display = '';
  btn.textContent = '匯出圖片';
  btn.disabled = false;

  const link = document.createElement('a');
  link.download = 'pricing-comparison.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
}
</script>
